{% comment %}
  Section: Informações do produto
  Arquivo: sections/informacoesproduto.liquid
{% endcomment %}

{% liquid
  assign roma_preview = false
  assign display_title = product.title
  assign current_variant = product.selected_or_first_available_variant
  if product.handle == 'men-women-vintage-sunglasses-rectangle-pc-frame-sunglasses-fashion-retro-sun-glasses-luxury-brand-design-shades-eyewear-goggles'
    assign roma_preview = true
    assign display_title = 'Soven Roma'

  endif
  assign form_id = 'InformacoesProduto-' | append: section.id
  assign elements_scale_desktop = section.settings.elements_scale_desktop | divided_by: 100.0
  assign elements_scale_mobile = section.settings.elements_scale_mobile | divided_by: 100.0
%}

{% style %}
  @font-face {
    font-family: 'Zierde Grotesk';
    src: url('https://cdn.shopify.com/s/files/1/0780/8211/3725/files/zierde-grotesk-medium.otf?v=1782228267') format('opentype');
    font-style: normal;
    font-weight: 500;
    font-display: swap;
  }

  /* Mantém o desenho original das linhas, mas impede que qualquer extensão
     seja contabilizada fora da largura visível da section. */
  #shopify-section-{{ section.id }} {
    width: 100%;
    max-width: 100vw;
    overflow-x: clip !important;
    overflow-y: visible !important;
  }

  #shopify-section-{{ section.id }} > * {
    max-width: 100%;
  }

  @supports not (overflow: clip) {
    #shopify-section-{{ section.id }} {
      overflow-x: hidden !important;
    }
  }

  #ip-{{ section.id }} {
    --section-bg: {{ section.settings.background }};
    --gallery-gap: {{ section.settings.gallery_gap }}px;
    --large-height: {{ section.settings.large_height }}px;
    --small-height: {{ section.settings.small_height }}px;
    --mobile-height: {{ section.settings.mobile_height }}px;
    --media-bg: {{ section.settings.media_background }};
    --media-radius: {{ section.settings.media_radius }}px;
    --dot-size: {{ section.settings.dot_size }}px;
    --dot-active-width: {{ section.settings.dot_active_width }}px;
    --dot-gap: {{ section.settings.dot_gap }}px;
    --dot-color: {{ section.settings.dot_color }};
    --dot-active-color: {{ section.settings.dot_active_color }};

    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding:
      {{ section.settings.padding_top }}px
      {{ section.settings.padding_horizontal }}px
      {{ section.settings.padding_bottom }}px;
    background: var(--section-bg);
    box-sizing: border-box;
    overflow: visible;
  }

  #ip-{{ section.id }} *,
  #ip-{{ section.id }} *::before,
  #ip-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #ip-{{ section.id }} .ip-layout {
    display: grid;
    grid-template-columns:
      minmax(0, {{ section.settings.gallery_width }}fr)
      minmax(300px, {{ 100 | minus: section.settings.gallery_width }}fr);
    gap: {{ section.settings.columns_gap }}px;
    align-items: stretch;
    overflow: visible;
  }

  /* TAMANHO GERAL DOS BLOCOS
     0% = normal
     -50% = metade
     100% = dobro
     200% = triplo
  */

  #ip-{{ section.id }} .ip-size {
    width: clamp(
      0%,
      calc(100% + var(--size-adjustment-desktop, var(--size-adjustment, 0%))),
      100%
    );
    max-width: 100%;
    margin-inline: auto !important;
    box-sizing: border-box;
  }

  /* A escala geral deve manter espaços laterais idênticos.
     Por isso, o alinhamento individual não desloca blocos redimensionados. */
  #ip-{{ section.id }} .ip-size.ip-align-left,
  #ip-{{ section.id }} .ip-size.ip-align-center,
  #ip-{{ section.id }} .ip-size.ip-align-right {
    margin-inline: auto !important;
  }

  #ip-{{ section.id }} .ip-align-left {
    margin-left: 0;
    margin-right: auto;
  }

  #ip-{{ section.id }} .ip-align-center {
    margin-left: auto;
    margin-right: auto;
  }

  #ip-{{ section.id }} .ip-align-right {
    margin-left: auto;
    margin-right: 0;
  }

  /* GALERIA DESKTOP */

  #ip-{{ section.id }} .ip-gallery-column {
    min-width: 0;
    width: calc(100% + {{ section.settings.gallery_size }}%);
  }

  /* LINHA SEPARADORA DA GALERIA — SOMENTE COMPUTADOR */
  @media screen and (min-width: 990px) {
    #ip-{{ section.id }} .ip-gallery-column {
      position: relative;
      align-self: start;
    }

    {% if section.settings.show_gallery_divider %}
      #ip-{{ section.id }} .ip-gallery-column::after {
        content: '';
        position: absolute;
        z-index: 2;
        top: 0;
        bottom: 0;
        right: calc(-1 * {{ section.settings.gallery_divider_gap }}px);
        width: 0;
        border-right: {{ section.settings.gallery_divider_width }}px {{ section.settings.gallery_divider_style }} {{ section.settings.gallery_divider_color }};
        pointer-events: none;
      }
    {% endif %}
  }

  #ip-{{ section.id }} .ip-gallery {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gallery-gap);
    width: 100%;
  }

  #ip-{{ section.id }} .ip-media {
    position: relative;
    min-width: 0;
    margin-top: var(--d-space-top, 0px);
    margin-bottom: var(--d-space-bottom, 0px);
    padding-left: calc(var(--d-space-both, 0px) + var(--d-space-left, 0px));
    padding-right: calc(var(--d-space-both, 0px) + var(--d-space-right, 0px));
    overflow: hidden;
    background: var(--media-bg);
    border-radius: var(--media-radius);
  }

  #ip-{{ section.id }} .ip-media--full {
    grid-column: span 4;
  }

  #ip-{{ section.id }} .ip-media--half {
    grid-column: span 2;
  }

  #ip-{{ section.id }} .ip-media--quarter {
    grid-column: span 1;
  }

  #ip-{{ section.id }} .ip-media--large {
    height: var(--large-height);
  }

  #ip-{{ section.id }} .ip-media--small {
    height: var(--small-height);
  }

  @media screen and (min-width: 990px) {
    #ip-{{ section.id }} .ip-media.ip-frame-d-vertical {
      height: auto;
      aspect-ratio: 4 / 5;
    }

    #ip-{{ section.id }} .ip-media.ip-frame-d-square {
      height: auto;
      aspect-ratio: 1 / 1;
    }

    #ip-{{ section.id }} .ip-media.ip-frame-d-horizontal {
      height: auto;
      aspect-ratio: 4 / 3;
    }

    #ip-{{ section.id }} .ip-media.ip-frame-d-wide {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  #ip-{{ section.id }} .ip-media-inner {
    overflow: hidden;
  }

  #ip-{{ section.id }} .ip-media img,
  #ip-{{ section.id }} .ip-media video,
  #ip-{{ section.id }} .ip-media iframe,
  #ip-{{ section.id }} .ip-media model-viewer {
    transform: scale(var(--desktop-media-scale, 1));
    transform-origin: center center;
    transition: transform 0.2s ease;
  }

  #ip-{{ section.id }} .ip-media-inner,
  #ip-{{ section.id }} .ip-media img,
  #ip-{{ section.id }} .ip-media video,
  #ip-{{ section.id }} .ip-media iframe,
  #ip-{{ section.id }} .ip-media model-viewer {
    display: block;
    width: 100%;
    height: 100%;
  }

  #ip-{{ section.id }} .ip-media img,
  #ip-{{ section.id }} .ip-media video {
    object-fit: var(--media-fit, cover);
    object-position: var(--media-position, center center);
  }

  #ip-{{ section.id }} .ip-media iframe {
    border: 0;
  }

  #ip-{{ section.id }} .ip-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  #ip-{{ section.id }} .ip-placeholder svg {
    width: 45%;
    max-width: 300px;
  }

  /* INFORMAÇÕES */

  #ip-{{ section.id }} {
    max-width: 100%;
    overflow-x: clip;
  }

  #ip-{{ section.id }} .ip-info {
    position: relative;
    min-width: 0;
    align-self: stretch;
    overflow: visible;
  }

  #ip-{{ section.id }} .ip-info-inner {
    width: min(calc(100% + {{ section.settings.information_size }}%), 100%);
    max-width: {{ section.settings.information_width }}px;
    margin: 0 auto;
    padding:
      {{ section.settings.info_padding_top_desktop }}px
      {{ section.settings.info_padding_horizontal_desktop }}px
      {{ section.settings.info_padding_bottom_desktop }}px;
    transform: none;
    will-change: auto;
    box-sizing: border-box;
  }

  #ip-{{ section.id }} .ip-form {
    width: {{ section.settings.information_content_width_desktop }}%;
    max-width: 100%;
    margin-inline: auto !important;
    padding-left: {{ section.settings.information_symmetric_space_desktop }}px;
    padding-right: {{ section.settings.information_symmetric_space_desktop }}px;
    box-sizing: border-box;
  }

  {% if section.settings.sticky_information %}
    @media screen and (min-width: 990px) {
      #ip-{{ section.id }} .ip-info-inner {
        position: -webkit-sticky;
        position: sticky;
        top: 0;
        z-index: 2;
      }
    }
  {% endif %}

  #ip-{{ section.id }} .ip-block {
    margin-top: var(--d-space-top, 0px);
    margin-bottom: var(--d-space-bottom, 0px);
    padding-left: calc(var(--d-space-both, 0px) + var(--d-space-left, 0px));
    padding-right: calc(var(--d-space-both, 0px) + var(--d-space-right, 0px));
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  #ip-{{ section.id }} .ip-block + .ip-block {
    margin-top: calc({{ section.settings.blocks_gap }}px + var(--d-space-top, 0px));
  }

  /* TEXTO */

  #ip-{{ section.id }} .ip-eyebrow,
  #ip-{{ section.id }} .ip-title,
  #ip-{{ section.id }} .ip-content {
    margin: 0;
    color: var(--color);
    font-size: var(--font-size);
    font-weight: var(--font-weight);
    line-height: var(--line-height);
    letter-spacing: var(--letter-spacing);
    text-align: var(--text-align);
    text-transform: var(--text-transform);
    overflow-wrap: anywhere;
  }

  #ip-{{ section.id }} .ip-content p {
    margin: 0 0 12px;
  }

  #ip-{{ section.id }} .ip-content p:last-child {
    margin-bottom: 0;
  }

  #ip-{{ section.id }} .ip-content img {
    max-width: 100%;
    height: auto;
  }

  /* PREÇO */

  #ip-{{ section.id }} .ip-prices {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  #ip-{{ section.id }} .ip-price {
    color: var(--price-color);
    font-size: var(--price-size);
    font-weight: var(--price-weight);
    line-height: 1.2;
  }

  #ip-{{ section.id }} .ip-compare {
    color: var(--compare-color);
    font-size: var(--compare-size);
    text-decoration: line-through;
  }

  #ip-{{ section.id }} .ip-compare[hidden] {
    display: none;
  }

  /* POSIÇÃO DO PREÇO — CONTROLES INDEPENDENTES PARA PC E MOBILE */
  #ip-{{ section.id }} .ip-price-position.ip-price-align-d-left {
    margin-left: 0 !important;
    margin-right: auto !important;
  }

  #ip-{{ section.id }} .ip-price-position.ip-price-align-d-center {
    margin-left: auto !important;
    margin-right: auto !important;
  }

  #ip-{{ section.id }} .ip-price-position.ip-price-align-d-right {
    margin-left: auto !important;
    margin-right: 0 !important;
  }

  #ip-{{ section.id }} .ip-price-position.ip-price-align-d-left .ip-prices {
    justify-content: flex-start;
    text-align: left;
  }

  #ip-{{ section.id }} .ip-price-position.ip-price-align-d-center .ip-prices {
    justify-content: center;
    text-align: center;
  }

  #ip-{{ section.id }} .ip-price-position.ip-price-align-d-right .ip-prices {
    justify-content: flex-end;
    text-align: right;
  }

  @media screen and (max-width: 989px) {
    #ip-{{ section.id }} .ip-price-position.ip-price-align-m-left {
      margin-left: 0 !important;
      margin-right: auto !important;
    }

    #ip-{{ section.id }} .ip-price-position.ip-price-align-m-center {
      margin-left: auto !important;
      margin-right: auto !important;
    }

    #ip-{{ section.id }} .ip-price-position.ip-price-align-m-right {
      margin-left: auto !important;
      margin-right: 0 !important;
    }

    #ip-{{ section.id }} .ip-price-position.ip-price-align-m-left .ip-prices {
      justify-content: flex-start;
      text-align: left;
    }

    #ip-{{ section.id }} .ip-price-position.ip-price-align-m-center .ip-prices {
      justify-content: center;
      text-align: center;
    }

    #ip-{{ section.id }} .ip-price-position.ip-price-align-m-right .ip-prices {
      justify-content: flex-end;
      text-align: right;
    }
  }

  /* DIVISOR */

  #ip-{{ section.id }} {
    max-width: 100%;
    overflow-x: clip;
  }

  @supports not (overflow: clip) {
    #ip-{{ section.id }} {
      overflow-x: hidden;
    }
  }

  #ip-{{ section.id }} .ip-divider {
    --divider-left-effective: min(
      var(--divider-left-extension, 0px),
      var(--divider-left-limit, 0px)
    );
    --divider-right-effective: min(
      var(--divider-right-extension, 0px),
      var(--divider-right-limit, 0px)
    );
    width: calc(100% + var(--divider-left-effective) + var(--divider-right-effective));
    max-width: none;
    height: var(--divider-height);
    margin-left: calc(-1 * var(--divider-left-effective));
    background: var(--divider-color);
  }

  /* VARIANTES */

  #ip-{{ section.id }} .ip-option {
    margin: 0;
    padding: 0;
    border: 0;
  }

  #ip-{{ section.id }} .ip-option + .ip-option {
    margin-top: var(--option-groups-gap);
  }

  #ip-{{ section.id }} .ip-option-header {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: var(--option-title-gap);
  }

  #ip-{{ section.id }} .ip-option-title,
  #ip-{{ section.id }} .ip-option-selected {
    margin: 0;
    padding: 0;
    color: var(--option-label-color);
    font-size: var(--option-label-size);
    font-weight: var(--option-label-weight);
  }

  #ip-{{ section.id }} .ip-option-values {
    display: grid;
    grid-template-columns: repeat(var(--option-columns), minmax(0, 1fr));
    gap: var(--option-gap);
  }

  #ip-{{ section.id }} .ip-option-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  #ip-{{ section.id }} .ip-option-button {
    min-height: var(--option-height);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    border: var(--option-border-width) solid var(--option-border-color);
    border-radius: var(--option-radius);
    background: var(--option-background);
    color: var(--option-color);
    font-size: var(--option-size);
    cursor: pointer;
    text-align: center;
  }

  #ip-{{ section.id }}
  .ip-option-input:checked
  + .ip-option-button {
    background: var(--option-active-background);
    color: var(--option-active-color);
    border-color: var(--option-active-border);
  }

  /* SELECTOR DE COLOR — círculos con imagen de la variante */
  #ip-{{ section.id }} .ip-option--color .ip-option-header {
    align-items: baseline;
    justify-content: flex-start;
    gap: 0.35em;
    margin-bottom: 18px;
  }

  #ip-{{ section.id }} .ip-option--color .ip-option-title,
  #ip-{{ section.id }} .ip-option--color .ip-option-selected {
    color: var(--option-label-color);
    font-size: clamp(20px, 1.65vw, 26px);
    font-weight: 400;
    line-height: 1.2;
  }

  #ip-{{ section.id }} .ip-option--color .ip-option-values {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    padding: 7px;
  }

  #ip-{{ section.id }} .ip-option--color .ip-option-values > div {
    flex: 0 0 auto;
  }

  #ip-{{ section.id }} .ip-option--technical {
    display: none;
  }

  #ip-{{ section.id }} .ip-option--color .ip-option-button--color {
    --ip-color-size: 64px;

    position: relative;
    display: block;
    width: var(--ip-color-size);
    min-width: var(--ip-color-size);
    height: var(--ip-color-size);
    min-height: var(--ip-color-size);
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 50%;
    outline: 0 solid transparent;
    outline-offset: 4px;
    background: transparent;
  }

  #ip-{{ section.id }} .ip-color-swatch-visual {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-radius: 50%;
    background-color: var(--ip-color-fill, #f4f2ef);
    background-image: var(--ip-color-image, none);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  #ip-{{ section.id }} .ip-option--color .ip-option-input:checked + .ip-option-button--color {
    outline: 4px solid #111111;
    outline-offset: 4px;
    background: transparent;
  }

  #ip-{{ section.id }} .ip-option--color .ip-option-input:focus-visible + .ip-option-button--color {
    outline: 3px solid #111111;
    outline-offset: 5px;
  }

  #ip-{{ section.id }} .ip-option--color .ip-option-input:not(:checked) + .ip-option-button--color:hover {
    outline: 2px solid rgba(17, 17, 17, 0.45);
    outline-offset: 4px;
    opacity: 1;
  }

  #ip-{{ section.id }} .ip-option--color .ip-option-button--color.is-unavailable {
    cursor: not-allowed;
    opacity: 0.42;
  }

  #ip-{{ section.id }} .ip-option--color .ip-option-button--color.is-unavailable::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 4px;
    right: 4px;
    height: 1px;
    background: rgba(17, 17, 17, 0.42);
    transform: rotate(-45deg);
  }

  #ip-{{ section.id }} .ip-visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  #ip-{{ section.id }} .ip-media.is-variant-selected {
    order: -1;
  }

  /* QUANTIDADE */

  #ip-{{ section.id }} .ip-quantity-label {
    display: block;
    margin-bottom: 8px;
    color: var(--quantity-label-color);
    font-size: var(--quantity-label-size);
    font-weight: var(--quantity-label-weight);
  }

  #ip-{{ section.id }} .ip-quantity {
    display: inline-grid;
    grid-template-columns: 44px 54px 44px;
    border: var(--quantity-border-width) solid var(--quantity-border-color);
    border-radius: var(--quantity-radius);
    overflow: hidden;
  }

  #ip-{{ section.id }} .ip-quantity button,
  #ip-{{ section.id }} .ip-quantity input {
    width: 100%;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: var(--quantity-background);
    color: var(--quantity-color);
    text-align: center;
    font: inherit;
  }

  #ip-{{ section.id }} .ip-quantity button {
    font-size: 20px;
    cursor: pointer;
  }

  #ip-{{ section.id }} .ip-quantity input {
    appearance: textfield;
  }

  #ip-{{ section.id }} .ip-quantity input::-webkit-inner-spin-button,
  #ip-{{ section.id }} .ip-quantity input::-webkit-outer-spin-button {
    appearance: none;
    margin: 0;
  }

  /* BOTÃO */

  #ip-{{ section.id }} .ip-buttons {
    display: grid;
    gap: var(--buttons-gap);
  }

  #ip-{{ section.id }} .ip-add {
    width: min(var(--button-width-desktop, 100%), 100%);
    max-width: 100%;
    box-sizing: border-box;
    min-height: var(--button-height);
    padding:
      var(--button-padding-vertical-desktop, 12px)
      var(--button-padding-horizontal-desktop, 20px);
    border: var(--button-border-width) solid var(--button-border-color);
    border-radius: var(--button-radius);
    background: var(--button-background);
    color: var(--button-color);
    font-size: var(--button-size);
    font-weight: var(--button-weight);
    letter-spacing: var(--button-spacing);
    text-transform: var(--button-transform);
    cursor: pointer;
  }

  #ip-{{ section.id }} .ip-add:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  #ip-{{ section.id }} .shopify-payment-button,
  #ip-{{ section.id }} .shopify-payment-button__button {
    width: 100%;
    min-height: var(--button-height);
  }


  /* DESIGN PREMIUM — TÍTULO ATÉ BOTÃO DE COMPRA
     Mantém todos os controles individuais já existentes no editor. */
  #ip-{{ section.id }} .ip-info-inner,
  #ip-{{ section.id }} .ip-info-inner button,
  #ip-{{ section.id }} .ip-info-inner input,
  #ip-{{ section.id }} .ip-info-inner select,
  #ip-{{ section.id }} .ip-info-inner textarea {
    font-family: 'Helvetica Now Text Light', Helvetica, Arial, sans-serif !important;
  }

  #ip-{{ section.id }} .ip-accordion,
  #ip-{{ section.id }} .ip-accordion *,
  #ip-{{ section.id }} .ip-details,
  #ip-{{ section.id }} .ip-details *,
  #ip-{{ section.id }} details,
  #ip-{{ section.id }} details * {
    font-family: 'Helvetica Now Text Light', Helvetica, Arial, sans-serif !important;
  }

  #ip-{{ section.id }} .ip-title {
    max-width: var(--title-max-width-desktop, 100%);
    font-family: 'Helvetica Now Text Light', Helvetica, Arial, sans-serif !important;
    font-weight: var(--title-font-weight-desktop, 300);
    text-align: var(--title-text-align-desktop, left);
    text-wrap: balance;
  }

  #ip-{{ section.id }} .ip-title,
  #ip-{{ section.id }} .ip-title * {
    font-family: 'Helvetica Now Text Light', Helvetica, Arial, sans-serif !important;
  }

  #ip-{{ section.id }} .ip-size-guide-trigger {
    font-family: inherit;
    font-size: var(--size-guide-trigger-size-desktop, inherit);
    font-weight: var(--size-guide-trigger-weight-desktop, 400);
    line-height: 1.2;
    cursor: pointer;
  }

  #ip-size-guide-{{ section.id }}[hidden] {
    display: none !important;
  }

  #ip-size-guide-{{ section.id }} {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: grid;
    place-items: center;
    padding: 20px;
    box-sizing: border-box;
  }

  #ip-size-guide-{{ section.id }} .ip-size-guide-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  #ip-size-guide-{{ section.id }} .ip-size-guide-dialog {
    position: relative;
    z-index: 1;
    width: min(100%, {{ section.settings.size_guide_width }}px);
    max-height: 88vh;
    overflow-y: auto;
    background: {{ section.settings.size_guide_background }};
    color: {{ section.settings.size_guide_text_color }};
    border: {{ section.settings.size_guide_border_width }}px solid {{ section.settings.size_guide_border_color }};
    border-radius: {{ section.settings.size_guide_border_radius }}px;
    padding: {{ section.settings.size_guide_padding_desktop }}px;
    box-sizing: border-box;
  }

  #ip-size-guide-{{ section.id }} .ip-size-guide-close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 38px;
    height: 38px;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
  }

  #ip-size-guide-{{ section.id }} .ip-size-guide-heading {
    margin: 0 48px 18px 0;
    font-size: {{ section.settings.size_guide_title_size_desktop }}px;
    line-height: 1.15;
  }

  #ip-size-guide-{{ section.id }} .ip-size-guide-content {
    font-size: {{ section.settings.size_guide_text_size_desktop }}px;
    line-height: 1.5;
  }

  #ip-size-guide-{{ section.id }} .ip-size-guide-content table {
    width: 100%;
    border-collapse: collapse;
  }

  #ip-size-guide-{{ section.id }} .ip-size-guide-content th,
  #ip-size-guide-{{ section.id }} .ip-size-guide-content td {
    border: 1px solid {{ section.settings.size_guide_table_border_color }};
    padding: 10px;
    text-align: left;
  }


  #ip-{{ section.id }} .ip-option-header {
    align-items: flex-end;
  }

  #ip-{{ section.id }} .ip-option-title,
  #ip-{{ section.id }} .ip-option-selected {
    line-height: 1.2;
    letter-spacing: inherit;
  }

  #ip-{{ section.id }} .ip-option-values {
    align-items: stretch;
  }

  #ip-{{ section.id }} .ip-option-button {
    position: relative;
    min-width: 0;
    background: transparent;
    border-top: 0;
    border-left: 0;
    border-right: 0;
    border-radius: 0;
    line-height: 1.2;
    transition: opacity .2s ease, border-color .2s ease, color .2s ease, background .2s ease;
  }

  #ip-{{ section.id }} .ip-option-button:hover {
    opacity: .72;
  }

  #ip-{{ section.id }} .ip-option-input:focus-visible + .ip-option-button {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  #ip-{{ section.id }} .ip-option-input:checked + .ip-option-button {
    background: transparent;
  }

  #ip-{{ section.id }} .ip-buy-size {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  #ip-{{ section.id }} .ip-buttons {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  #ip-{{ section.id }} .ip-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: opacity .2s ease, background .2s ease, color .2s ease;
  }

  #ip-{{ section.id }} .ip-add:hover:not(:disabled) {
    opacity: .84;
  }

  #ip-{{ section.id }} .ip-add:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media screen and (max-width: 989px) {
    #ip-{{ section.id }} .ip-size-guide-trigger {
      font-size: var(--size-guide-trigger-size-mobile, var(--size-guide-trigger-size-desktop, inherit));
      font-weight: var(--size-guide-trigger-weight-mobile, var(--size-guide-trigger-weight-desktop, 400));
    }

    #ip-size-guide-{{ section.id }} .ip-size-guide-dialog {
      padding: {{ section.settings.size_guide_padding_mobile }}px;
    }

    #ip-size-guide-{{ section.id }} .ip-size-guide-heading {
      font-size: {{ section.settings.size_guide_title_size_mobile }}px;
    }

    #ip-size-guide-{{ section.id }} .ip-size-guide-content {
      font-size: {{ section.settings.size_guide_text_size_mobile }}px;
    }

    #ip-{{ section.id }} .ip-quantity-label {
      font-size: var(--quantity-label-size-mobile, var(--quantity-label-size));
    }

    #ip-{{ section.id }} .ip-size {
      width: clamp(
        0%,
        calc(100% + var(--size-adjustment-mobile, 0%)),
        100%
      );
      max-width: 100%;
      margin-inline: auto !important;
    }

    #ip-{{ section.id }} .ip-info-inner {
      padding:
        {{ section.settings.info_padding_top_mobile }}px
        {{ section.settings.info_padding_horizontal_mobile }}px
        {{ section.settings.info_padding_bottom_mobile }}px;
    }

    #ip-{{ section.id }} .ip-form {
      width: {{ section.settings.information_content_width_mobile }}%;
      max-width: 100%;
      margin-inline: auto !important;
      padding-left: {{ section.settings.information_symmetric_space_mobile }}px;
      padding-right: {{ section.settings.information_symmetric_space_mobile }}px;
      box-sizing: border-box;
    }

    #ip-{{ section.id }} .ip-title,
    #ip-{{ section.id }} .ip-price,
    #ip-{{ section.id }} .ip-compare,
    #ip-{{ section.id }} .ip-option-title,
    #ip-{{ section.id }} .ip-option-selected,
    #ip-{{ section.id }} .ip-option-button,
    #ip-{{ section.id }} .ip-add {
      max-width: 100%;
      overflow-wrap: anywhere;
    }
  }

  /* ACCORDION */

  #ip-{{ section.id }} .ip-accordion {
    position: relative;
    border: 0;
  }

  #ip-{{ section.id }} .ip-accordion::before,
  #ip-{{ section.id }} .ip-accordion::after {
    content: "";
    position: absolute;
    --accordion-left-effective: min(
      var(--accordion-left-extension, 0px),
      var(--accordion-left-limit, 0px)
    );
    --accordion-right-effective: min(
      var(--accordion-right-extension, 0px),
      var(--accordion-right-limit, 0px)
    );
    left: calc(-1 * var(--accordion-left-effective));
    width: calc(100% + var(--accordion-left-effective) + var(--accordion-right-effective));
    height: var(--accordion-border-width);
    background: var(--accordion-border);
    pointer-events: none;
  }

  #ip-{{ section.id }} .ip-accordion::before { top: 0; }
  #ip-{{ section.id }} .ip-accordion::after { bottom: 0; }

  #ip-{{ section.id }} .ip-accordion-summary {
    min-height: var(--accordion-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 0;
    color: var(--accordion-title-color);
    font-size: var(--accordion-title-size);
    font-weight: var(--accordion-title-weight);
    list-style: none;
    cursor: pointer;
  }

  #ip-{{ section.id }} .ip-accordion-summary::-webkit-details-marker {
    display: none;
  }

  #ip-{{ section.id }} .ip-accordion-icon {
    position: relative;
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
  }

  #ip-{{ section.id }} .ip-accordion-icon::before,
  #ip-{{ section.id }} .ip-accordion-icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 1px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  #ip-{{ section.id }} .ip-accordion-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  #ip-{{ section.id }}
  .ip-accordion[open]
  .ip-accordion-icon::after {
    transform: translate(-50%, -50%);
  }

  #ip-{{ section.id }} .ip-accordion-content {
    padding-bottom: 20px;
    color: var(--accordion-content-color);
    font-size: var(--accordion-content-size);
    line-height: var(--accordion-content-line-height);
  }

  /* ACCORDIONS DUPLICADOS: SEM ESPAÇO E SEM LINHA DUPLICADA */
  #ip-{{ section.id }} .ip-block--accordion:has(+ .ip-block--accordion) {
    margin-bottom: 0;
  }

  #ip-{{ section.id }} .ip-block--accordion + .ip-block--accordion {
    margin-top: 0;
  }

  #ip-{{ section.id }} .ip-block--accordion + .ip-block--accordion .ip-accordion::before {
    display: none;
  }

  /* BOLINHAS */

  #ip-{{ section.id }} .ip-dots {
    display: none;
  }

  #ip-{{ section.id }} .ip-dot {
    width: var(--dot-size);
    height: var(--dot-size);
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--dot-color);
    opacity: 0.4;
    cursor: pointer;
    transition: width 0.2s ease, opacity 0.2s ease;
  }

  #ip-{{ section.id }} .ip-dot.is-active {
    width: var(--dot-active-width);
    background: var(--dot-active-color);
    opacity: 1;
  }

  /* MOBILE */

  @media screen and (max-width: 989px) {
    #ip-{{ section.id }} {
      padding:
        {{ section.settings.mobile_padding_top }}px
        {{ section.settings.mobile_padding_horizontal }}px
        {{ section.settings.mobile_padding_bottom }}px;
    }

    #ip-{{ section.id }} .ip-layout {
      display: block;
    }

    #ip-{{ section.id }} .ip-gallery-column {
      width: calc(100% + {{ section.settings.mobile_gallery_size }}%);
      margin: 0 auto;
    }

    #ip-{{ section.id }} .ip-gallery {
      display: flex;
      gap: 0;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
    }

    #ip-{{ section.id }} .ip-gallery::-webkit-scrollbar {
      display: none;
    }

    #ip-{{ section.id }} .ip-media,
    #ip-{{ section.id }} .ip-media--full,
    #ip-{{ section.id }} .ip-media--half,
    #ip-{{ section.id }} .ip-media--quarter {
      flex: 0 0 100%;
      width: 100%;
      height: {% if section.settings.limit_mobile_height %}min(var(--mobile-height), {{ section.settings.mobile_height_vh }}vh){% else %}var(--mobile-height){% endif %};
      grid-column: auto;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    #ip-{{ section.id }} .ip-media.ip-frame-m-vertical {
      height: auto;
      aspect-ratio: 4 / 5;
    }

    #ip-{{ section.id }} .ip-media.ip-frame-m-square {
      height: auto;
      aspect-ratio: 1 / 1;
    }

    #ip-{{ section.id }} .ip-media.ip-frame-m-horizontal {
      height: auto;
      aspect-ratio: 4 / 3;
    }

    #ip-{{ section.id }} .ip-media.ip-frame-m-wide {
      height: auto;
      aspect-ratio: 16 / 9;
    }

    #ip-{{ section.id }} .ip-media img,
    #ip-{{ section.id }} .ip-media video,
    #ip-{{ section.id }} .ip-media iframe,
    #ip-{{ section.id }} .ip-media model-viewer {
      transform: scale(var(--mobile-media-scale, 1));
    }


    #ip-{{ section.id }} .ip-dots {
      display: flex;
      align-items: center;
      justify-content: {{ section.settings.dots_alignment }};
      gap: var(--dot-gap);
      margin:
        {{ section.settings.dots_top }}px
        0
        {{ section.settings.dots_bottom }}px;
    }

    #ip-{{ section.id }} .ip-info {
      position: static;
      align-self: auto;
      margin-top: {{ section.settings.mobile_info_top }}px;
    }

    #ip-{{ section.id }} .ip-info-inner {
      position: static;
      width: min(calc(100% + {{ section.settings.mobile_information_size }}%), 100vw);
      max-width: 100%;
      margin: 0 auto;
    }

    #ip-{{ section.id }} .ip-media,
    #ip-{{ section.id }} .ip-block {
      margin-top: var(--m-space-top, 0px);
      margin-bottom: var(--m-space-bottom, 0px);
      padding-left: calc(var(--m-space-both, 0px) + var(--m-space-left, 0px));
      padding-right: calc(var(--m-space-both, 0px) + var(--m-space-right, 0px));
    }

    #ip-{{ section.id }} .ip-block + .ip-block {
      margin-top: calc({{ section.settings.blocks_gap }}px + var(--m-space-top, 0px));
    }

    #ip-{{ section.id }} .ip-block--accordion:has(+ .ip-block--accordion) {
      margin-bottom: 0;
    }

    #ip-{{ section.id }} .ip-block--accordion + .ip-block--accordion {
      margin-top: 0;
    }

    #ip-{{ section.id }} .ip-title {
      max-width: var(--title-max-width-mobile, 100%);
      font-size: var(--mobile-font-size, var(--font-size));
      font-weight: var(--title-font-weight-mobile, var(--title-font-weight-desktop, 300));
      text-align: var(--title-text-align-mobile, var(--title-text-align-desktop, left));
    }

    #ip-{{ section.id }} .ip-price {
      font-size: var(--mobile-price-size, var(--price-size));
    }

    #ip-{{ section.id }} .ip-option-values {
      grid-template-columns:
        repeat(var(--option-columns-mobile), minmax(0, 1fr));
    }

    /* MOBILE — correção estrutural contra scroll horizontal.
       A largura real dos blocos permanece em 100%. As extensões das linhas
       são desenhadas somente por pseudo-elementos, portanto não entram no
       cálculo de largura do documento. */
    #shopify-section-{{ section.id }} {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      overflow-x: clip !important;
    }

    #ip-{{ section.id }},
    #ip-{{ section.id }} .ip-layout,
    #ip-{{ section.id }} .ip-info,
    #ip-{{ section.id }} .ip-info-inner {
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }

    #ip-{{ section.id }} {
      overflow-x: clip !important;
    }

    #ip-{{ section.id }} .ip-layout,
    #ip-{{ section.id }} .ip-info,
    #ip-{{ section.id }} .ip-info-inner {
      overflow-x: clip !important;
    }

    @supports not (overflow: clip) {
      #shopify-section-{{ section.id }},
      #ip-{{ section.id }},
      #ip-{{ section.id }} .ip-layout,
      #ip-{{ section.id }} .ip-info,
      #ip-{{ section.id }} .ip-info-inner {
        overflow-x: hidden !important;
      }
    }

    #ip-{{ section.id }} .ip-block--divider,
    #ip-{{ section.id }} .ip-block--accordion {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      transform: none !important;
    }

    /* O divisor deixa de aumentar fisicamente sua própria largura no mobile.
       A linha continua com a mesma aparência e extensões configuradas. */
    #ip-{{ section.id }} .ip-divider {
      position: relative;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0;
      margin-left: 0 !important;
      background: transparent;
    }

    #ip-{{ section.id }} .ip-divider::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(-1 * var(--divider-left-effective));
      width: calc(100% + var(--divider-left-effective) + var(--divider-right-effective));
      max-width: none;
      background: var(--divider-color);
      pointer-events: none;
    }

    /* As bordas do acordeão já são pseudo-elementos. Mantemos o desenho
       original e garantimos que o próprio acordeão nunca fique maior que 100%. */
    #ip-{{ section.id }} .ip-accordion {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    #ip-{{ section.id }} .ip-divider::before,
    #ip-{{ section.id }} .ip-accordion::before,
    #ip-{{ section.id }} .ip-accordion::after {
      contain: paint;
    }
  }


  /* ESCALA GERAL MOBILE: variantes, preço comparado e botão de compra */
  @media screen and (max-width: 989px) {
    #ip-{{ section.id }} .ip-compare {
      font-size: var(--mobile-compare-size, var(--compare-size));
    }

    #ip-{{ section.id }} .ip-option + .ip-option {
      margin-top: var(--option-groups-gap-mobile, var(--option-groups-gap));
    }

    #ip-{{ section.id }} .ip-option-header {
      margin-bottom: var(--option-title-gap-mobile, var(--option-title-gap));
    }

    #ip-{{ section.id }} .ip-option-values {
      gap: var(--option-gap-mobile, var(--option-gap));
    }

    #ip-{{ section.id }} .ip-option-title,
    #ip-{{ section.id }} .ip-option-selected {
      font-size: var(--option-label-size-mobile, var(--option-label-size));
    }

    #ip-{{ section.id }} .ip-option-button {
      min-height: var(--option-height-mobile, var(--option-height));
      font-size: var(--option-size-mobile, var(--option-size));
    }

    #ip-{{ section.id }} .ip-option--color .ip-option-values {
      gap: 20px;
      padding: 6px;
    }

    #ip-{{ section.id }} .ip-option--color .ip-option-button--color {
      --ip-color-size: 42px;
    }

    #ip-{{ section.id }} .ip-option--color .ip-option-title,
    #ip-{{ section.id }} .ip-option--color .ip-option-selected {
      font-size: 19px;
    }

    #ip-{{ section.id }} .ip-buttons {
      gap: var(--buttons-gap-mobile, var(--buttons-gap));
    }

    #ip-{{ section.id }} .ip-add,
    #ip-{{ section.id }} .shopify-payment-button,
    #ip-{{ section.id }} .shopify-payment-button__button {
      min-height: var(--button-height-mobile, var(--button-height));
    }

    #ip-{{ section.id }} .ip-add {
      width: min(var(--button-width-mobile, 100%), 100%);
      max-width: 100%;
      box-sizing: border-box;
      min-height: var(--button-height-mobile, var(--button-height));
      padding:
        var(--button-padding-vertical-mobile, 12px)
        var(--button-padding-horizontal-mobile, 20px);
      font-size: var(--button-size-mobile, var(--button-size));
      letter-spacing: var(--button-spacing-mobile, var(--button-spacing));
    }
  }

  /* ORDER BUMP / PRODUTO COMPLEMENTAR */
  #ip-{{ section.id }} .ip-order-bump {
    width: min(var(--ob-width-desktop, 100%), 100%);
    max-width: 100%;
    min-width: 0;
    margin-left: var(--ob-margin-left-desktop, 0px);
    margin-right: var(--ob-margin-right-desktop, 0px);
    margin-top: var(--ob-margin-top-desktop, 0px);
    margin-bottom: var(--ob-margin-bottom-desktop, 0px);
    padding: var(--ob-padding-desktop, 0px);
    background: var(--ob-background, transparent);
    border: var(--ob-border-width, 0px) solid var(--ob-border-color, transparent);
    border-radius: var(--ob-radius, 0px);
    overflow: hidden;
  }

  #ip-{{ section.id }} .ip-order-bump-heading {
    margin: 0 0 var(--ob-heading-gap-desktop, 22px);
    color: var(--ob-heading-color, #111111);
    font-size: var(--ob-heading-size-desktop, 22px);
    line-height: var(--ob-heading-line-height, 1.1);
    font-weight: var(--ob-heading-weight, 700);
    letter-spacing: var(--ob-heading-letter-spacing, 0px);
    text-transform: var(--ob-heading-transform, uppercase);
    text-align: var(--ob-heading-align, left);
  }

  #ip-{{ section.id }} .ip-order-bump-main {
    display: grid;
    grid-template-columns: var(--ob-image-width-desktop, 190px) minmax(0, 1fr);
    gap: var(--ob-gap-desktop, 28px);
