                        --ob-title-letter-spacing: {{ block.settings.title_letter_spacing }}px;
                        --ob-title-transform: {{ block.settings.title_transform }};
                        --ob-price-gap-desktop: {{ block.settings.price_gap_desktop | times: ob_scale_d }}px;
                        --ob-price-gap-mobile: {{ block.settings.price_gap_mobile | times: ob_scale_m }}px;
                        --ob-price-color: {{ block.settings.price_color }};
                        --ob-price-size-desktop: {{ block.settings.price_size_desktop | times: ob_scale_d }}px;
                        --ob-price-size-mobile: {{ block.settings.price_size_mobile | times: ob_scale_m }}px;
