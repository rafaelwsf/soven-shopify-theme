                      >
                        +
                      </button>
                    </div>
                  </div>

                {% when 'buy_buttons' %}
                  <div
                    class="
                      ip-block ip-buy-size
                      ip-align-{{ block.settings.element_alignment }}
                    "
                    {{ block.shopify_attributes }}
                    data-buy-block
                    data-available="{{ block.settings.available_text | escape }}"
                    data-sold-out="{{ block.settings.sold_out_text | escape }}"
                    data-unavailable="{{ block.settings.unavailable_text | escape }}"
                    style="
                      --button-scale-desktop: {{ block.settings.element_size | plus: 100 | divided_by: 100.0 }};
                      --button-scale-mobile: {{ block.settings.element_size_mobile | plus: 100 | divided_by: 100.0 }};
                        --d-space-top: {{ block.settings.desktop_space_top }}px;
                        --m-space-top: {{ block.settings.mobile_space_top }}px;
                        --d-space-bottom: {{ block.settings.desktop_space_bottom }}px;
                        --m-space-bottom: {{ block.settings.mobile_space_bottom }}px;
                    --d-space-left: {{ block.settings.desktop_space_left }}px;
                        --m-space-left: {{ block.settings.mobile_space_left }}px;
                        --d-space-right: {{ block.settings.desktop_space_right }}px;
                        --m-space-right: {{ block.settings.mobile_space_right }}px;
                        --d-space-both: {{ block.settings.desktop_space_both }}px;
                        --m-space-both: {{ block.settings.mobile_space_both }}px;
                      --buttons-gap: calc({{ block.settings.gap | times: elements_scale_desktop }}px * var(--button-scale-desktop));
                      --buttons-gap-mobile: calc({{ block.settings.gap | times: elements_scale_mobile }}px * var(--button-scale-mobile));
                      --button-height: calc({{ block.settings.height | times: elements_scale_desktop }}px * var(--button-scale-desktop));
                      --button-height-mobile: calc({{ block.settings.height | times: elements_scale_mobile }}px * var(--button-scale-mobile));
                      --button-width-desktop: {{ block.settings.button_width_desktop }}%;
                      --button-width-mobile: {{ block.settings.button_width_mobile }}%;
                      --button-padding-vertical-desktop: calc({{ block.settings.padding_vertical_desktop }}px * var(--button-scale-desktop));
                      --button-padding-horizontal-desktop: calc({{ block.settings.padding_horizontal_desktop }}px * var(--button-scale-desktop));
                      --button-padding-vertical-mobile: calc({{ block.settings.padding_vertical_mobile }}px * var(--button-scale-mobile));
                      --button-padding-horizontal-mobile: calc({{ block.settings.padding_horizontal_mobile }}px * var(--button-scale-mobile));
                      --button-border-width: {{ block.settings.border_width }}px;
                      --button-border-color: {{ block.settings.border_color }};
                      --button-radius: {{ block.settings.radius }}px;
                      --button-background: {{ block.settings.background }};
                      --button-color: {{ block.settings.color }};
                      --button-size: calc({{ block.settings.font_size | times: elements_scale_desktop }}px * var(--button-scale-desktop));
                      --button-size-mobile: calc({{ block.settings.font_size | times: elements_scale_mobile }}px * var(--button-scale-mobile));
                      --button-weight: {{ block.settings.font_weight }};
                      --button-spacing: {{ block.settings.letter_spacing | times: elements_scale_desktop }}px;
                      --button-spacing-mobile: {{ block.settings.letter_spacing | times: elements_scale_mobile }}px;
                      --button-transform: {{ block.settings.text_transform }};
                    "
                  >
                    <div class="ip-buttons">
                      <button
                        type="submit"
                        name="add"
                        class="ip-add"
