                        --ob-variant-border-color: {{ block.settings.variant_border_color }};
                        --ob-variant-radius: {{ block.settings.variant_radius }}px;
                        --ob-button-gap-mobile: {{ block.settings.button_gap_mobile | times: ob_scale_m }}px;
                        --ob-button-height-desktop: {{ block.settings.button_height_desktop | times: ob_scale_d }}px;
                        --ob-button-height-mobile: {{ block.settings.button_height_mobile | times: ob_scale_m }}px;
                        --ob-button-background: {{ block.settings.button_background }};
                        --ob-button-color: {{ block.settings.button_color }};
                        --ob-button-border-width: {{ block.settings.button_border_width }}px;
                        --ob-button-border-color: {{ block.settings.button_border_color }};
                        --ob-button-radius: {{ block.settings.button_radius_desktop }}px;
                        --ob-button-radius-mobile: {{ block.settings.button_radius_mobile }}px;
                        --ob-button-size-desktop: {{ block.settings.button_size_desktop | times: ob_scale_d }}px;
                        --ob-button-size-mobile: {{ block.settings.button_size_mobile | times: ob_scale_m }}px;
                        --ob-button-weight: {{ block.settings.button_weight }};
                        --ob-button-letter-spacing: {{ block.settings.button_letter_spacing }}px;
                        --ob-button-transform: {{ block.settings.button_transform }};
                      "
                    >
                      {% if block.settings.heading != blank %}
                        <h3 class="ip-order-bump-heading">{{ block.settings.heading }}</h3>
                      {% endif %}

                      <div class="ip-order-bump-main">
                        <div class="ip-order-bump-image-wrap">
                          {% if bump_image != blank %}
                            {{ bump_image | image_url: width: 1000 | image_tag: class: 'ip-order-bump-image', loading: 'lazy', widths: '180, 260, 360, 520, 760, 1000' }}
                          {% else %}
                            {{ 'product-1' | placeholder_svg_tag: 'ip-order-bump-image' }}
                          {% endif %}
                        </div>

                        <div class="ip-order-bump-content">
                          <h4 class="ip-order-bump-title">{{ bump_title }}</h4>
                          <div class="ip-order-bump-price" data-order-bump-price>{{ bump_variant.price | money }}</div>

                          {% if bump_product.variants.size > 1 and block.settings.show_variant_selector %}
                            <select class="ip-order-bump-variant" data-order-bump-variant aria-label="Variante de {{ bump_product.title | escape }}">
                              {% for variant in bump_product.variants %}
                                <option
                                  value="{{ variant.id }}"
                                  data-price="{{ variant.price }}"
                                  {% if variant.id == bump_variant.id %}selected{% endif %}
                                  {% unless variant.available %}disabled{% endunless %}
                                >
                                  {{ variant.title }}{% unless variant.available %} — Agotado{% endunless %}
                                </option>
                              {% endfor %}
                            </select>
                          {% else %}
                            <input type="hidden" value="{{ bump_variant.id }}" data-order-bump-variant>
                          {% endif %}

                          <button
                            type="button"
                            class="ip-order-bump-button"
                            data-order-bump-add
                            data-default-text="{{ block.settings.button_text | escape }}"
                            data-loading-text="{{ block.settings.loading_text | escape }}"
                            data-success-text="{{ block.settings.success_text | escape }}"
                            data-error-text="{{ block.settings.error_text | escape }}"
                            {% unless bump_variant.available %}disabled{% endunless %}
                          >
                            {% if bump_variant.available %}{{ block.settings.button_text }}{% else %}{{ block.settings.sold_out_text }}{% endif %}
                          </button>
                        </div>
                      </div>
                    </div>
                  {% endif %}

                {% when 'accordion' %}
                  <div
                    class="
                      ip-block ip-block--accordion ip-size
                      ip-align-{{ block.settings.element_alignment }}
                    "
                    {{ block.shopify_attributes }}
                    style="
                      --size-adjustment: {{ block.settings.element_size }}%;
                      --size-adjustment-desktop: {{ block.settings.element_size }}%;
                      --size-adjustment-mobile: {{ block.settings.element_size_mobile }}%;
                        --d-space-top: {{ block.settings.desktop_space_top }}px;
                        --m-space-top: {{ block.settings.mobile_space_top }}px;
                        --d-space-bottom: {{ block.settings.desktop_space_bottom }}px;
                        --m-space-bottom: {{ block.settings.mobile_space_bottom }}px;
                    --d-space-left: {{ block.settings.desktop_space_left }}px;
                        --m-space-left: {{ block.settings.mobile_space_left }}px;
                        --d-space-right: {{ block.settings.desktop_space_right }}px;
                        --m-space-right: {{ block.settings.mobile_space_right }}px;
                        --d-space-both: {{ block.settings.desktop_space_both }}px;
                        --m-space-both: {{ block.settings.mobile_space_both }}px;
                      --accordion-border-width: {{ block.settings.border_width_custom }}px;
                      --accordion-border: {{ block.settings.border_color }};
                      --accordion-left-extension: {{ block.settings.desktop_left_extension }}px;
                      --accordion-right-extension: {{ block.settings.desktop_right_extension }}px;
                      --accordion-height: {{ block.settings.heading_height }}px;
                      --accordion-title-color: {{ block.settings.heading_color }};
                      --accordion-title-size: {{ block.settings.heading_size }}px;
                      --accordion-title-weight: {{ block.settings.heading_weight }};
                      --accordion-content-color: {{ block.settings.content_color }};
                      --accordion-content-size: {{ block.settings.content_size }}px;
                      --accordion-content-line-height: {{ block.settings.line_height }};
                    "
                  >
                    <details
                      class="ip-accordion"
                      {% if block.settings.open %}
                        open
                      {% endif %}
                    >
                      <summary class="ip-accordion-summary">
                        <span>{{ block.settings.heading }}</span>
                        <span class="ip-accordion-icon"></span>
                      </summary>

                      <div class="ip-accordion-content rte">
                        {{ block.settings.content }}

                        {% if block.settings.page != blank %}
                          {{ block.settings.page.content }}
                        {% endif %}
                      </div>
                    </details>
                  </div>

              {% endcase %}
            {% endfor %}

          {% endform %}
        </div>
      </div>
    </div>

    {% if roma_preview %}{% render 'soven-roma-variant-media' %}{% endif %}
    <script type="application/json" data-variants>
      {{ product.variants | json }}
    </script>
  {% else %}
    <div style="padding: 50px 20px; text-align: center;">
      Añade esta sección a una plantilla de producto.
    </div>
  {% endif %}
</section>

<script>
  (() => {
    const section = document.getElementById('ip-{{ section.id }}');

    if (!section || section.dataset.ready === 'true') return;
    section.dataset.ready = 'true';

    const gallery = section.querySelector('[data-gallery]');
    const slides = [...section.querySelectorAll('[data-slide]')];
    const dotsBox = section.querySelector('[data-dots]');

    function createDots() {
      if (!gallery || !dotsBox || slides.length < 2) {
        if (dotsBox) dotsBox.style.display = 'none';
        return;
      }

      dotsBox.innerHTML = '';

      slides.forEach((slide, index) => {
        const dot = document.createElement('button');

        dot.type = 'button';
        dot.className = 'ip-dot';
        dot.setAttribute('aria-label', `Mostrar imagen ${index + 1}`);

        if (index === 0) {
          dot.classList.add('is-active');
          dot.setAttribute('aria-current', 'true');
        }

        dot.addEventListener('click', () => {
          gallery.scrollTo({
            left: slide.offsetLeft,
            behavior: 'smooth'
          });
        });

        dotsBox.appendChild(dot);
      });
    }

    function updateDots() {
      if (!gallery || !dotsBox || slides.length < 2) return;

      const current = Math.round(
        gallery.scrollLeft / Math.max(gallery.clientWidth, 1)
      );

      dotsBox.querySelectorAll('.ip-dot').forEach((dot, index) => {
        const active = index === current;

        dot.classList.toggle('is-active', active);

        if (active) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    }

    createDots();

    function updateLineExtensionLimits() {
      const desktop = window.matchMedia('(min-width: 990px)').matches;
      const galleryColumn = section.querySelector('.ip-gallery-column');
      const sectionRect = section.getBoundingClientRect();
      const viewportWidth = Math.min(
        window.innerWidth || document.documentElement.clientWidth,
        document.documentElement.clientWidth
      );
      const safety = desktop ? 1 : 4;

      /* Desktop permanece igual. No mobile, o limite absoluto passa a ser
         exclusivamente a área visível da viewport, sem usar largura de
         galeria, 100vw ou elementos que possam estar temporariamente maiores. */
      const siteLeft = desktop
        ? Math.max(0, sectionRect.left)
        : safety;
      const siteRight = desktop
        ? Math.max(siteLeft, Math.min(sectionRect.right, viewportWidth) - safety)
        : Math.max(siteLeft, viewportWidth - safety);

      const dividerEnabled = {{ section.settings.show_gallery_divider | json }};
      let leftBoundary = siteLeft;

      /* No desktop, a extensão esquerda para exatamente na linha vertical
         que separa a galeria da coluna de informações. */
      if (desktop && galleryColumn && dividerEnabled) {
        const galleryRect = galleryColumn.getBoundingClientRect();
        const separatorX = galleryRect.right + {{ section.settings.gallery_divider_gap }};
        leftBoundary = Math.min(siteRight, Math.max(siteLeft, separatorX));
      }

      const applyLimits = (element, leftLimitProperty, rightLimitProperty) => {
        /* Zera apenas os limites para medir o tamanho natural do elemento.
           No mobile a extensão é somente visual, por pseudo-elemento. */
        element.style.setProperty(leftLimitProperty, '0px');
        element.style.setProperty(rightLimitProperty, '0px');

        const naturalRect = element.getBoundingClientRect();
        const naturalLeft = Math.min(siteRight, Math.max(siteLeft, naturalRect.left));
        const naturalRight = Math.max(siteLeft, Math.min(siteRight, naturalRect.right));

        const leftAvailable = Math.max(0, naturalLeft - leftBoundary);
        const rightAvailable = Math.max(0, siteRight - naturalRight);

        element.style.setProperty(leftLimitProperty, `${Math.max(0, Math.floor(leftAvailable))}px`);
        element.style.setProperty(rightLimitProperty, `${Math.max(0, Math.floor(rightAvailable))}px`);
      };

      section.querySelectorAll('.ip-divider').forEach((element) => {
        applyLimits(element, '--divider-left-limit', '--divider-right-limit');
      });

      section.querySelectorAll('.ip-accordion').forEach((element) => {
        applyLimits(element, '--accordion-left-limit', '--accordion-right-limit');
      });
    }

    updateLineExtensionLimits();
    requestAnimationFrame(() => {
      updateLineExtensionLimits();
      requestAnimationFrame(updateLineExtensionLimits);
    });

    window.addEventListener('load', updateLineExtensionLimits, { once: true });

    let extensionResizeFrame;

    window.addEventListener('resize', () => {
      cancelAnimationFrame(extensionResizeFrame);
      extensionResizeFrame = requestAnimationFrame(updateLineExtensionLimits);
    });

    if (window.ResizeObserver) {
      const extensionObserver = new ResizeObserver(() => {
        cancelAnimationFrame(extensionResizeFrame);
        extensionResizeFrame = requestAnimationFrame(updateLineExtensionLimits);
      });

      extensionObserver.observe(section);
    }

    let scrollTimer;

    if (gallery) {
      gallery.addEventListener(
        'scroll',
        () => {
          clearTimeout(scrollTimer);
          scrollTimer = setTimeout(updateDots, 40);
        },
        { passive: true }
      );
    }

    const romaMediaElement = section.querySelector('[data-roma-variant-media]');
    const romaMedia = romaMediaElement ? JSON.parse(romaMediaElement.textContent) : {};
    const romaViews = ['Vista frontal', 'Vista tres cuartos derecha', 'Vista lateral', 'Vista tres cuartos izquierda'];
    function updateRomaMedia(variant) {
      const media = romaMedia[variant?.id];
      if (!media) return;
      section.querySelectorAll('[data-roma-image]').forEach((image) => {
        const index = Number(image.dataset.romaImage);
        image.src = media.images[index];
        image.alt = 'Soven Roma — ' + media.label + ' — ' + romaViews[index];
      });
      if (gallery) gallery.scrollLeft = 0;
      const selectedLabel = section.querySelector('[data-selected-value="2"]');
      if (selectedLabel) selectedLabel.textContent = media.label;
    }
    const variantsElement = section.querySelector('[data-variants]');
    const variantInput = section.querySelector('[data-variant-id]');
    const price = section.querySelector('[data-price]');
    const compare = section.querySelector('[data-compare]');
    const pricesBox = section.querySelector('.ip-prices[data-price-mode]');
    const usesManualPrice = pricesBox?.dataset.priceMode === 'manual';
    const addButton = section.querySelector('[data-add]');
    const addText = section.querySelector('[data-add-text]');
    const buyBlock = section.querySelector('[data-buy-block]');
    const quantity = section.querySelector('[data-quantity]');

    let variants = [];

    try {
      variants = variantsElement
        ? JSON.parse(variantsElement.textContent)
        : [];
    } catch (error) {
      console.error('Error al cargar las variantes.', error);
    }

    const locale = document.documentElement.lang || 'es-ES';
    const currency = {{ cart.currency.iso_code | default: shop.currency | json }};

    function money(cents) {
      try {
        return new Intl.NumberFormat(locale, {
          style: 'currency',
          currency
        }).format(cents / 100);
      } catch (error) {
        return `${(cents / 100).toFixed(2)} ${currency}`;
      }
    }

    function selectedOptions() {
      const options = [];

      section.querySelectorAll('[data-option-group]').forEach((group) => {
        const position = Number(group.dataset.optionPosition);
        const checked = group.querySelector('[data-option-input]:checked');

        if (checked) options[position - 1] = checked.value;
      });

      return options;
    }

    function selectedVariant() {

      const options = selectedOptions();

      return variants.find((variant) =>
        variant.options.every(
          (option, index) => option === options[index]
        )
      );
    }

    function updateSelectedLabels() {
      section.querySelectorAll('[data-selected-value]').forEach((label) => {
        const position = Number(label.dataset.selectedValue);

        const checked = section.querySelector(
          `[data-option-input][data-option-position="${position}"]:checked`
        );

        if (checked) label.textContent = checked.value;
      });
    }

    function showVariantMedia(variant) {
      if (
        !variant ||
        !variant.featured_media ||
        !gallery
      ) {
        return;
      }

      const media = section.querySelector(
        `[data-media-id="${variant.featured_media.id}"]`
      );

      if (media) {
        slides.forEach((slide) => {
          slide.classList.toggle('is-variant-selected', slide === media);
        });

        if (window.matchMedia('(max-width: 989px)').matches) {
          gallery.scrollTo({
            left: media.offsetLeft,
            behavior: 'smooth'
          });
        }
      }
    }

    function updateVariant(variant) {
      updateSelectedLabels();

      if (!variant) {
        if (variantInput) variantInput.value = '';
        if (addButton) addButton.disabled = true;

        if (addText && buyBlock) {
          addText.textContent =
            buyBlock.dataset.unavailable || 'NO DISPONIBLE';
        }

        return;
      }

      if (variantInput) variantInput.value = variant.id;
      updateRomaMedia(variant);

      /* O preço manual é apenas visual e permanece fixo mesmo ao trocar
         de variante. O valor cobrado no carrinho continua sendo o valor
         real configurado no produto/variante da Shopify. */
      if (!usesManualPrice) {
        if (price) price.textContent = money(variant.price);

        if (compare) {
          const hasCompare =
            variant.compare_at_price &&
            variant.compare_at_price > variant.price;

          compare.hidden = !hasCompare;
          compare.textContent = hasCompare
            ? money(variant.compare_at_price)
            : '';
        }
      }

      if (addButton) addButton.disabled = !variant.available;

      if (addText && buyBlock) {
        addText.textContent = variant.available
          ? buyBlock.dataset.available
          : buyBlock.dataset.soldOut;
      }

      const url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url.toString());

      showVariantMedia(variant);
      section.dispatchEvent(new CustomEvent('soven:variant-changed', { detail: variant }));
    }

    section.querySelectorAll('[data-option-input]').forEach((input) => {
      input.addEventListener('change', () => {
        updateVariant(selectedVariant());
      });
    });

    updateVariant(selectedVariant());

    section
      .querySelector('[data-quantity-minus]')
      ?.addEventListener('click', () => {
        if (!quantity) return;

        quantity.value = Math.max(
          1,
          (parseInt(quantity.value, 10) || 1) - 1
        );
      });

    section
      .querySelector('[data-quantity-plus]')
      ?.addEventListener('click', () => {
        if (!quantity) return;

        quantity.value =
          (parseInt(quantity.value, 10) || 1) + 1;
      });

    /* ORDER BUMP: adiciona o produto complementar ao carrinho sem recarregar. */
    section.querySelectorAll('[data-order-bump]').forEach((bump) => {
      const button = bump.querySelector('[data-order-bump-add]');
      const variantField = bump.querySelector('[data-order-bump-variant]');
      const priceField = bump.querySelector('[data-order-bump-price]');

      if (!button || !variantField) return;

      variantField.addEventListener?.('change', () => {
        const option = variantField.options?.[variantField.selectedIndex];
        const cents = Number(option?.dataset.price || 0);
        if (priceField && cents) priceField.textContent = money(cents);
        button.disabled = Boolean(option?.disabled);
      });

      button.addEventListener('click', async () => {
        if (button.disabled) return;

        const variantId = Number(variantField.value);
        if (!variantId) return;

        const defaultText = button.dataset.defaultText || 'AÑADIR AL CARRITO';
        button.disabled = true;
        button.textContent = button.dataset.loadingText || 'AÑADIENDO...';

        try {
          const response = await fetch(`${window.Shopify?.routes?.root || '/'}cart/add.js`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
          });

          if (!response.ok) throw new Error('Não foi possível adicionar o produto.');

          const added = await response.json();
          button.textContent = button.dataset.successText || 'AÑADIDO';

          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          document.documentElement.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { cart: added } }));
          document.dispatchEvent(new CustomEvent('product:added', { bubbles: true, detail: added }));

          if (bump.dataset.afterAdd === 'cart') {
            window.location.href = `${window.Shopify?.routes?.root || '/'}cart`;
            return;
          }

          window.setTimeout(() => {
            button.disabled = false;
            button.textContent = defaultText;
          }, 1800);
        } catch (error) {
          console.error(error);
          button.textContent = button.dataset.errorText || 'INTÉNTALO DE NUEVO';
          window.setTimeout(() => {
            button.disabled = false;
            button.textContent = defaultText;
          }, 2200);
        }
      });
    });

  })();
</script>


<div
  id="ip-size-guide-{{ section.id }}"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ip-size-guide-title-{{ section.id }}"
  hidden
>
  <div class="ip-size-guide-overlay" data-size-guide-close></div>

  <div class="ip-size-guide-dialog">
    <button
      type="button"
      class="ip-size-guide-close"
      aria-label="Close size guide"
      data-size-guide-close
    >
      ×
    </button>

    <h2 id="ip-size-guide-title-{{ section.id }}" class="ip-size-guide-heading">
      {{ section.settings.size_guide_title }}
    </h2>

    <div class="ip-size-guide-content rte">
      {{ section.settings.size_guide_content }}
    </div>
  </div>
</div>

<script>
  (() => {
    const section = document.getElementById('ip-{{ section.id }}');
    const modal = document.getElementById('ip-size-guide-{{ section.id }}');

    if (!section || !modal || modal.dataset.initialized === 'true') return;
    modal.dataset.initialized = 'true';

    let lastFocusedElement = null;

    const openModal = () => {
      lastFocusedElement = document.activeElement;
      modal.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      modal.querySelector('.ip-size-guide-close')?.focus();
    };

    const closeModal = () => {
      modal.hidden = true;
      document.documentElement.style.overflow = '';
      lastFocusedElement?.focus();
    };

    section.querySelectorAll('[data-size-guide-open]').forEach((button) => {
      button.addEventListener('click', openModal);
    });

    modal.querySelectorAll('[data-size-guide-close]').forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) closeModal();
    });
  })();
</script>

