    padding: 0 14px;
    color: var(--ob-variant-color, #111111);
    background: var(--ob-variant-background, #ffffff);
    border: var(--ob-variant-border-width, 1px) solid var(--ob-variant-border-color, #cccccc);
    border-radius: var(--ob-variant-radius, 0px);
    font: inherit;
  }

  #ip-{{ section.id }} .ip-order-bump-button {
    width: 100%;
    min-height: var(--ob-button-height-desktop, 66px);
    margin-top: auto;
    padding: 12px 20px;
    border: var(--ob-button-border-width, 0px) solid var(--ob-button-border-color, #111111);
    border-radius: var(--ob-button-radius, 8px);
    background: var(--ob-button-background, #111111);
    color: var(--ob-button-color, #ffffff);
    font-size: var(--ob-button-size-desktop, 22px);
    font-weight: var(--ob-button-weight, 700);
    letter-spacing: var(--ob-button-letter-spacing, 0px);
    text-transform: var(--ob-button-transform, uppercase);
    cursor: pointer;
    transition: opacity .2s ease, background .2s ease, color .2s ease;
  }

  #ip-{{ section.id }} .ip-order-bump-button:hover { opacity: .9; }
  #ip-{{ section.id }} .ip-order-bump-button:disabled { opacity: .55; cursor: not-allowed; }

  @media screen and (max-width: 989px) {
    #ip-{{ section.id }} .ip-order-bump {
      width: min(var(--ob-width-mobile, 100%), 100%);
      max-width: 100%;
      min-width: 0;
      margin-left: var(--ob-margin-left-mobile, 0px);
      margin-right: var(--ob-margin-right-mobile, 0px);
      margin-top: var(--ob-margin-top-mobile, 0px);
      margin-bottom: var(--ob-margin-bottom-mobile, 0px);
      padding: var(--ob-padding-mobile, 0px);
    }

    #ip-{{ section.id }} .ip-order-bump-heading {
      margin-bottom: var(--ob-heading-gap-mobile, 16px);
      font-size: var(--ob-heading-size-mobile, 18px);
    }

    #ip-{{ section.id }} .ip-order-bump-main {
      grid-template-columns: var(--ob-image-width-mobile, 110px) minmax(0, 1fr);
      gap: var(--ob-gap-mobile, 14px);
    }

    #ip-{{ section.id }} .ip-order-bump-image-wrap {
      width: var(--ob-image-width-mobile, 110px);
      height: var(--ob-image-height-mobile, 145px);
    }

    #ip-{{ section.id }} .ip-order-bump-image {
      transform: scale(var(--ob-image-scale-mobile, 1));
    }

    #ip-{{ section.id }} .ip-order-bump-title {
      font-size: var(--ob-title-size-mobile, 16px);
    }

    #ip-{{ section.id }} .ip-order-bump-price {
      margin-top: var(--ob-price-gap-mobile, 10px);
      font-size: var(--ob-price-size-mobile, 17px);
    }

    #ip-{{ section.id }} .ip-order-bump-variant {
      margin-top: var(--ob-variant-gap-mobile, 10px);
      min-height: var(--ob-variant-height-mobile, 38px);
    }

    #ip-{{ section.id }} .ip-order-bump-button {
      min-height: var(--ob-button-height-mobile, 48px);
      margin-top: var(--ob-button-gap-mobile, 14px);
      font-size: var(--ob-button-size-mobile, 15px);
      border-radius: var(--ob-button-radius-mobile, var(--ob-button-radius, 8px));
    }
  }

{% endstyle %}

<section id="ip-{{ section.id }}" data-product-section>
  {% if product != blank %}
    <div class="ip-layout">

      <!-- GALERIA -->
      <div class="ip-gallery-column">
        <div
          class="ip-gallery"
          data-gallery
          aria-label="Galeria de {{ display_title | escape }}"
        >
          {% if roma_preview %}
            {% assign roma_photos = '01-frontal,02-tres-quartos-direita,03-lateral,04-tres-quartos-esquerda' | split: ',' %}
            {% assign roma_variant_code = current_variant.option2 %}
            {% assign roma_angles = 'Vista frontal,Vista tres cuartos derecha,Vista lateral,Vista tres cuartos izquierda' | split: ',' %}
            {% for photo in roma_photos %}
              <div class="ip-media ip-media--half ip-frame-d-square ip-frame-m-square" data-slide>
                <img src="{{ 'roma-variant-' | append: roma_variant_code | append: '-' | append: photo | append: '.webp' | asset_url }}"
                  data-roma-image="{{ forloop.index0 }}" alt="Soven Roma — {{ current_variant.option2 | escape }} — {{ roma_angles[forloop.index0] }}"
                  width="1600" height="1600"
                  {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                  style="display:block;width:100%;height:100%;object-fit:contain;background:#fff;">
              </div>
            {% endfor %}
          {% else %}
          {% assign visible_media_count = 0 %}

          {% if section.settings.automatic_product_content %}
            {% for media in product.media limit: 8 %}
              {% assign visible_media_count = visible_media_count | plus: 1 %}
              {% assign automatic_width = 'quarter' %}
              {% assign automatic_height = 'small' %}

              {% if forloop.index <= 2 %}
                {% assign automatic_width = 'half' %}
                {% assign automatic_height = 'large' %}
              {% endif %}

              <div
                class="ip-media ip-media--{{ automatic_width }} ip-media--{{ automatic_height }}"
                data-slide
                data-media-id="{{ media.id }}"
                style="
                  --media-fit: {{ section.settings.image_fit }};
                  --media-position: center center;
                  --desktop-media-scale: 1;
                  --mobile-media-scale: 1;
                "
              >
                <div class="ip-media-inner">
                  {% case media.media_type %}
                    {% when 'image' %}
                      {{
                        media
                        | image_url: width: 2400
                        | image_tag:
                          loading: 'lazy',
                          widths: '480, 750, 1000, 1500, 2000, 2400',
                          sizes: '(min-width: 990px) 50vw, 100vw',
                          alt: media.alt
                      }}
                    {% when 'video' %}
                      {{ media | video_tag: controls: true, muted: true, loop: section.settings.video_loop, autoplay: section.settings.video_autoplay, playsinline: true }}
                    {% when 'external_video' %}
                      {{ media | external_video_tag }}
                    {% when 'model' %}
                      {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
                    {% else %}
                      {{ media | media_tag }}
                  {% endcase %}
                </div>
              </div>
            {% endfor %}
          {% else %}
            {% for slot in (1..8) %}
            {% capture enabled_key %}image_{{ slot }}_enabled{% endcapture %}
            {% capture source_key %}image_{{ slot }}_source{% endcapture %}
            {% capture custom_key %}image_{{ slot }}_custom{% endcapture %}
            {% capture position_key %}image_{{ slot }}_media_position{% endcapture %}
            {% capture width_key %}image_{{ slot }}_width{% endcapture %}
            {% capture height_key %}image_{{ slot }}_height{% endcapture %}
            {% capture fit_key %}image_{{ slot }}_fit{% endcapture %}
            {% capture focal_key %}image_{{ slot }}_position{% endcapture %}
            {% capture desktop_scale_key %}image_{{ slot }}_desktop_scale{% endcapture %}
            {% capture mobile_scale_key %}image_{{ slot }}_mobile_scale{% endcapture %}
            {% capture desktop_frame_key %}image_{{ slot }}_desktop_frame{% endcapture %}
            {% capture mobile_frame_key %}image_{{ slot }}_mobile_frame{% endcapture %}

            {% assign slot_enabled = section.settings[enabled_key] %}
            {% assign slot_source = section.settings[source_key] %}
            {% assign slot_custom = section.settings[custom_key] %}
            {% assign slot_position = section.settings[position_key] %}
            {% assign media_index = slot_position | minus: 1 %}
            {% assign selected_media = product.media[media_index] %}
            {% assign slot_fit = section.settings[fit_key] %}
            {% assign desktop_scale_value = section.settings[desktop_scale_key] | plus: 100 | divided_by: 100.0 %}
            {% assign mobile_scale_value = section.settings[mobile_scale_key] | plus: 100 | divided_by: 100.0 %}
            {% assign desktop_frame_value = section.settings[desktop_frame_key] %}
            {% assign mobile_frame_value = section.settings[mobile_frame_key] %}

            {% if slot_fit == 'inherit' %}
              {% assign slot_fit = section.settings.image_fit %}
            {% endif %}

            {% if slot_enabled %}
              {% if slot_source == 'custom' and slot_custom != blank %}
                {% assign visible_media_count = visible_media_count | plus: 1 %}
              {% elsif slot_source == 'product' and selected_media != blank %}
                {% assign visible_media_count = visible_media_count | plus: 1 %}
              {% endif %}

              {% if slot_source == 'custom' and slot_custom != blank or slot_source == 'product' and selected_media != blank %}
                <div
                  class="ip-media ip-media--{{ section.settings[width_key] }} ip-media--{{ section.settings[height_key] }} ip-frame-d-{{ desktop_frame_value }} ip-frame-m-{{ mobile_frame_value }}"
                  data-slide
                  {% if slot_source == 'product' and selected_media != blank %}
                    data-media-id="{{ selected_media.id }}"
                  {% endif %}
                  style="
                    --media-fit: {{ slot_fit }};
                    --media-position: {{ section.settings[focal_key] }};
                    --desktop-media-scale: {{ desktop_scale_value }};
                    --mobile-media-scale: {{ mobile_scale_value }};
                  "
                >
                  <div class="ip-media-inner">
                    {% if slot_source == 'custom' and slot_custom != blank %}
                      {{
                        slot_custom
                        | image_url: width: 2400
                        | image_tag:
                          loading: 'lazy',
                          widths: '480, 750, 1000, 1500, 2000, 2400',
                          sizes: '(min-width: 990px) 50vw, 100vw',
                          alt: slot_custom.alt
                      }}
                    {% elsif selected_media != blank %}
                      {% case selected_media.media_type %}
                        {% when 'image' %}
                          {{
                            selected_media
                            | image_url: width: 2400
                            | image_tag:
                              loading: 'lazy',
                              widths: '480, 750, 1000, 1500, 2000, 2400',
                              sizes: '(min-width: 990px) 50vw, 100vw',
                              alt: selected_media.alt
                          }}
                        {% when 'video' %}
                          {{ selected_media | video_tag: controls: true, muted: true, loop: section.settings.video_loop, autoplay: section.settings.video_autoplay, playsinline: true }}
                        {% when 'external_video' %}
                          {{ selected_media | external_video_tag }}
                        {% when 'model' %}
                          {{ selected_media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
                        {% else %}
                          {{ selected_media | media_tag }}
                      {% endcase %}
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endif %}
            {% endfor %}
          {% endif %}

          {% if visible_media_count == 0 %}
            {% for media in product.media limit: 8 %}
              {% assign fallback_width = 'quarter' %}
              {% assign fallback_height = 'small' %}
              {% if forloop.index <= 2 %}
                {% assign fallback_width = 'half' %}
                {% assign fallback_height = 'large' %}
              {% endif %}
              <div
                class="ip-media ip-media--{{ fallback_width }} ip-media--{{ fallback_height }}"
                data-slide
                data-media-id="{{ media.id }}"
                style="--media-fit: {{ section.settings.image_fit }}; --media-position: center center;"
              >
                <div class="ip-media-inner">
                  {% case media.media_type %}
                    {% when 'image' %}
                      {{ media | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '480, 750, 1000, 1500, 2000, 2400', sizes: '(min-width: 990px) 50vw, 100vw', alt: media.alt }}
                    {% when 'video' %}
                      {{ media | video_tag: controls: true, muted: true, loop: section.settings.video_loop, autoplay: section.settings.video_autoplay, playsinline: true }}
                    {% when 'external_video' %}
                      {{ media | external_video_tag }}
                    {% when 'model' %}
                      {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
                    {% else %}
                      {{ media | media_tag }}
                  {% endcase %}
                </div>
              </div>
            {% else %}
              <div class="ip-media ip-media--full ip-media--large" data-slide>
                <div class="ip-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
              </div>
            {% endfor %}
          {% endif %}
          {% endif %}
        </div>

        <div
          class="ip-dots"
          data-dots
          aria-label="Navegación de imágenes"
        ></div>
      </div>

      <!-- INFORMAÇÕES -->
      <div class="ip-info">
        <div class="ip-info-inner">

          {% form 'product',
            product,
            id: form_id,
            class: 'ip-form',
            novalidate: 'novalidate'
          %}

            <input
              type="hidden"
              name="id"
              value="{{ current_variant.id }}"
              data-variant-id
            >

            {% for block in section.blocks %}
              {% case block.type %}

                {% when 'eyebrow' %}
                  {% if block.settings.text != blank %}
                    <div
                      class="
                        ip-block ip-size
                        ip-align-{{ block.settings.element_alignment }}
                      "
                      {{ block.shopify_attributes }}
                      style="
                        --size-adjustment: {{ block.settings.element_size }}%;
                        --size-adjustment-desktop: {{ block.settings.element_size }}%;
                        --size-adjustment-mobile: {{ block.settings.element_size_mobile }}%;
                        --d-space-top: {{ block.settings.desktop_space_top }}px;
                        --m-space-top: {{ block.settings.mobile_space_top }}px;
                        --d-space-bottom: {{ block.settings.desktop_space_bottom }}px;
                        --m-space-bottom: {{ block.settings.mobile_space_bottom }}px;
                    --d-space-left: {{ block.settings.desktop_space_left }}px;
                        --m-space-left: {{ block.settings.mobile_space_left }}px;
                        --d-space-right: {{ block.settings.desktop_space_right }}px;
                        --m-space-right: {{ block.settings.mobile_space_right }}px;
                        --d-space-both: {{ block.settings.desktop_space_both }}px;
                        --m-space-both: {{ block.settings.mobile_space_both }}px;
                        --color: {{ block.settings.color }};
                        --font-size: {{ block.settings.font_size }}px;
                        --font-weight: {{ block.settings.font_weight }};
                        --line-height: {{ block.settings.line_height }};
                        --letter-spacing: {{ block.settings.letter_spacing }}px;
                        --text-align: {{ block.settings.text_alignment }};
                        --text-transform: {{ block.settings.text_transform }};
                      "
                    >
                      <p class="ip-eyebrow">
                        {{ block.settings.text | escape }}
                      </p>
                    </div>
                  {% endif %}

                {% when 'title' %}
                  <div
                    class="
                      ip-block ip-size
                      ip-align-{{ block.settings.element_alignment }}
                    "
                    {{ block.shopify_attributes }}
                    style="
                      --size-adjustment: {{ block.settings.element_size }}%;
                      --size-adjustment-desktop: {{ block.settings.element_size }}%;
                      --size-adjustment-mobile: {{ block.settings.element_size_mobile }}%;
                        --d-space-top: {{ block.settings.desktop_space_top }}px;
                        --m-space-top: {{ block.settings.mobile_space_top }}px;
                        --d-space-bottom: {{ block.settings.desktop_space_bottom }}px;
                        --m-space-bottom: {{ block.settings.mobile_space_bottom }}px;
                    --d-space-left: {{ block.settings.desktop_space_left }}px;
                        --m-space-left: {{ block.settings.mobile_space_left }}px;
                        --d-space-right: {{ block.settings.desktop_space_right }}px;
                        --m-space-right: {{ block.settings.mobile_space_right }}px;
                        --d-space-both: {{ block.settings.desktop_space_both }}px;
                        --m-space-both: {{ block.settings.mobile_space_both }}px;
                      --color: {{ block.settings.color }};
                      --font-size: {{ block.settings.font_size | times: elements_scale_desktop }}px;
                      --mobile-font-size: {{ block.settings.mobile_font_size | times: elements_scale_mobile }}px;
                      --font-weight: {{ block.settings.font_weight_desktop }};
                      --title-font-weight-desktop: {{ block.settings.font_weight_desktop }};
                      --title-font-weight-mobile: {{ block.settings.font_weight_mobile }};
                      --line-height: {{ block.settings.line_height }};
                      --letter-spacing: {{ block.settings.letter_spacing }}px;
                      --title-max-width-desktop: {{ block.settings.max_width_desktop }}%;
                      --title-max-width-mobile: {{ block.settings.max_width_mobile }}%;
                      --text-align: {{ block.settings.text_alignment_desktop }};
                      --title-text-align-desktop: {{ block.settings.text_alignment_desktop }};
                      --title-text-align-mobile: {{ block.settings.text_alignment_mobile }};
                      --text-transform: {{ block.settings.text_transform }};
                    "
                  >
                    <h1 class="ip-title">
                      {% if section.settings.automatic_product_content %}
                        {{ display_title | escape }}
                      {% elsif block.settings.title_source == 'custom' and block.settings.custom_title != blank %}
                        {{ block.settings.custom_title | escape }}
                      {% else %}
                        {{ display_title | escape }}
                      {% endif %}
                    </h1>
                  </div>

                {% when 'price' %}
                  <div
                    class="
                      ip-block ip-size ip-price-position
                      ip-price-align-d-{{ block.settings.element_alignment_desktop }}
                      ip-price-align-m-{{ block.settings.element_alignment_mobile }}
                    "
                    {{ block.shopify_attributes }}
                    style="
                      --size-adjustment: {{ block.settings.element_size }}%;
                      --size-adjustment-desktop: {{ block.settings.element_size }}%;
                      --size-adjustment-mobile: {{ block.settings.element_size_mobile }}%;
                        --d-space-top: {{ block.settings.desktop_space_top }}px;
                        --m-space-top: {{ block.settings.mobile_space_top }}px;
                        --d-space-bottom: {{ block.settings.desktop_space_bottom }}px;
                        --m-space-bottom: {{ block.settings.mobile_space_bottom }}px;
                    --d-space-left: {{ block.settings.desktop_space_left }}px;
                        --m-space-left: {{ block.settings.mobile_space_left }}px;
                        --d-space-right: {{ block.settings.desktop_space_right }}px;
                        --m-space-right: {{ block.settings.mobile_space_right }}px;
                        --d-space-both: {{ block.settings.desktop_space_both }}px;
                        --m-space-both: {{ block.settings.mobile_space_both }}px;
                      --price-color: {{ block.settings.color }};
                      --price-size: {{ block.settings.font_size | times: elements_scale_desktop }}px;
                      --mobile-price-size: {{ block.settings.mobile_font_size | times: elements_scale_mobile }}px;
                      --price-weight: {{ block.settings.font_weight }};
                      --compare-color: {{ block.settings.compare_color }};
                      --compare-size: {{ block.settings.compare_size | times: elements_scale_desktop }}px;
                      --mobile-compare-size: {{ block.settings.compare_size | times: elements_scale_mobile }}px;
                    "
                  >
                    <div
                      class="ip-prices"
                      data-price-mode="{{ block.settings.price_source }}"
                    >
                      <span class="ip-price" data-price>
                        {% if block.settings.price_source == 'manual' and block.settings.manual_price != blank %}
                          {{ block.settings.manual_price | escape }}
                        {% else %}
                          {{ current_variant.price | money }}
                        {% endif %}
                      </span>

                      {% assign show_manual_compare = false %}
                      {% if block.settings.price_source == 'manual' and block.settings.manual_compare_price != blank %}
                        {% assign show_manual_compare = true %}
                      {% endif %}

                      <span
                        class="ip-compare"
                        data-compare
                        {% if block.settings.price_source == 'manual' %}
                          {% unless show_manual_compare %}
                            hidden
                          {% endunless %}
                        {% else %}
                          {% unless current_variant.compare_at_price > current_variant.price %}
                            hidden
                          {% endunless %}
                        {% endif %}
                      >
                        {% if block.settings.price_source == 'manual' %}
                          {% if show_manual_compare %}
                            {{ block.settings.manual_compare_price | escape }}
                          {% endif %}
                        {% elsif current_variant.compare_at_price > current_variant.price %}
                          {{ current_variant.compare_at_price | money }}
                        {% endif %}
                      </span>
                    </div>
                  </div>

                {% when 'divider' %}
                  <div
                    class="
                      ip-block ip-block--divider ip-size
                      ip-align-{{ block.settings.element_alignment }}
                    "
                    {{ block.shopify_attributes }}
                    style="
                      --size-adjustment: {{ block.settings.element_size }}%;
                      --size-adjustment-desktop: {{ block.settings.element_size }}%;
                      --size-adjustment-mobile: {{ block.settings.element_size_mobile }}%;
                        --d-space-top: {{ block.settings.desktop_space_top }}px;
                        --m-space-top: {{ block.settings.mobile_space_top }}px;
                        --d-space-bottom: {{ block.settings.desktop_space_bottom }}px;
                        --m-space-bottom: {{ block.settings.mobile_space_bottom }}px;
                    --d-space-left: {{ block.settings.desktop_space_left }}px;
                        --m-space-left: {{ block.settings.mobile_space_left }}px;
                        --d-space-right: {{ block.settings.desktop_space_right }}px;
                        --m-space-right: {{ block.settings.mobile_space_right }}px;
                        --d-space-both: {{ block.settings.desktop_space_both }}px;
                        --m-space-both: {{ block.settings.mobile_space_both }}px;
                      --divider-color: {{ block.settings.color }};
                      --divider-height: {{ block.settings.height }}px;
                      --divider-left-extension: {{ block.settings.desktop_left_extension }}px;
                      --divider-right-extension: {{ block.settings.desktop_right_extension }}px;
                    "
                  >
                    <div class="ip-divider"></div>
                  </div>

                {% when 'variant_picker' %}
                  {% if roma_preview %}{% render 'soven-roma-bundle', product: product, current_variant: current_variant, section: section %}{% endif %}
                  {% if product.has_only_default_variant == false %}
                    <div
                      class="
                        ip-block ip-size
                        ip-align-{{ block.settings.element_alignment }}
                      "
                      {{ block.shopify_attributes }}
                      style="
                        --size-adjustment: {{ block.settings.element_size }}%;
                      --size-adjustment-desktop: {{ block.settings.element_size }}%;
                      --size-adjustment-mobile: {{ block.settings.element_size_mobile }}%;
                        --d-space-top: {{ block.settings.desktop_space_top }}px;
                        --m-space-top: {{ block.settings.mobile_space_top }}px;
                        --d-space-bottom: {{ block.settings.desktop_space_bottom }}px;
                        --m-space-bottom: {{ block.settings.mobile_space_bottom }}px;
                    --d-space-left: {{ block.settings.desktop_space_left }}px;
                        --m-space-left: {{ block.settings.mobile_space_left }}px;
                        --d-space-right: {{ block.settings.desktop_space_right }}px;
                        --m-space-right: {{ block.settings.mobile_space_right }}px;
                        --d-space-both: {{ block.settings.desktop_space_both }}px;
                        --m-space-both: {{ block.settings.mobile_space_both }}px;
                        --option-groups-gap: {{ block.settings.groups_gap | times: elements_scale_desktop }}px;
                        --option-groups-gap-mobile: {{ block.settings.groups_gap | times: elements_scale_mobile }}px;
                        --option-title-gap: {{ block.settings.title_gap | times: elements_scale_desktop }}px;
                        --option-title-gap-mobile: {{ block.settings.title_gap | times: elements_scale_mobile }}px;
                        --option-columns: {{ block.settings.columns }};
                        --option-columns-mobile: {{ block.settings.mobile_columns }};
                        --option-gap: {{ block.settings.gap | times: elements_scale_desktop }}px;
                        --option-gap-mobile: {{ block.settings.gap | times: elements_scale_mobile }}px;
                        --option-height: {{ block.settings.height | times: elements_scale_desktop }}px;
                        --option-height-mobile: {{ block.settings.height | times: elements_scale_mobile }}px;
                        --option-label-color: {{ block.settings.label_color }};
                        --option-label-size: {{ block.settings.label_size | times: elements_scale_desktop }}px;
                        --option-label-size-mobile: {{ block.settings.label_size_mobile | times: elements_scale_mobile }}px;
                      --size-guide-trigger-size-desktop: {{ block.settings.size_guide_size_desktop }}px;
                      --size-guide-trigger-size-mobile: {{ block.settings.size_guide_size_mobile }}px;
                      --size-guide-trigger-weight-desktop: {{ block.settings.size_guide_weight_desktop }};
                      --size-guide-trigger-weight-mobile: {{ block.settings.size_guide_weight_mobile }};
                        --option-label-weight: {{ block.settings.label_weight }};
                        --option-border-width: {{ block.settings.border_width }}px;
                        --option-border-color: {{ block.settings.border_color }};
                        --option-radius: {{ block.settings.radius }}px;
                        --option-background: {{ block.settings.background }};
                        --option-color: {{ block.settings.color }};
                        --option-size: {{ block.settings.font_size | times: elements_scale_desktop }}px;
                        --option-size-mobile: {{ block.settings.font_size | times: elements_scale_mobile }}px;
                        --option-active-background: {{ block.settings.active_background }};
                        --option-active-color: {{ block.settings.active_color }};
                        --option-active-border: {{ block.settings.active_border }};
                      "
                    >
                      {% for option in product.options_with_values %}
                        {% liquid
                          assign normalized_option_name = option.name | strip | downcase
                          assign is_color_option = false
                          assign hide_technical_option = false
                          assign option_index = option.position | minus: 1
                          assign first_option_value = option.values.first | strip | downcase

                          if option.values.size == 1 and first_option_value == 'other'
                            assign hide_technical_option = true
                          elsif option.values.size == 1 and first_option_value == 'otro'
                            assign hide_technical_option = true
                          endif

                          if option.values.size > 1 and normalized_option_name contains 'color'
                            assign is_color_option = true
                          elsif option.values.size > 1 and normalized_option_name contains 'colour'
                            assign is_color_option = true
                          elsif option.values.size > 1 and normalized_option_name == 'cor'
                            assign is_color_option = true
                          endif
                        %}

                        <fieldset
                          class="ip-option{% if is_color_option %} ip-option--color{% endif %}{% if hide_technical_option %} ip-option--technical{% endif %}"
                          data-option-group
                          data-option-position="{{ option.position }}"
                        >

                          {% unless normalized_option_name == 'length' %}
                            <div class="ip-option-header">
                              {% assign custom_option_title = blank %}

                              {% case option.position %}
                                {% when 1 %}
                                  {% assign custom_option_title = block.settings.option_title_1 %}
                                {% when 2 %}
                                  {% assign custom_option_title = block.settings.option_title_2 %}
                                {% when 3 %}
                                  {% assign custom_option_title = block.settings.option_title_3 %}
                              {% endcase %}

                              <legend class="ip-option-title">
                                {% if is_color_option %}
                                  Color:
                                {% elsif custom_option_title != blank %}
                                  {{ custom_option_title }}
                                {% else %}
                                  {{ option.name }}
                                {% endif %}
                              </legend>

                              {% if is_color_option or block.settings.show_selected %}
                                <span
                                  class="ip-option-selected"
                                  data-selected-value="{{ option.position }}"
                                >
                                  {{ option.selected_value }}
                                </span>
                              {% endif %}
                            </div>
                          {% endunless %}

                          <div class="ip-option-values">
                            {% for value in option.values %}
                              {% assign normalized_value = value | strip | downcase %}

                              {% unless normalized_value == 'set 5' %}
                                {% if normalized_value == 'as picture' %}
                                  <div>
                                    <button
                                      type="button"
                                      class="ip-option-button ip-size-guide-trigger"
                                      data-size-guide-open
                                      aria-controls="ip-size-guide-{{ section.id }}"
                                      aria-haspopup="dialog"
                                    >
                                      Guía de tallas
                                    </button>
                                  </div>
                                {% else %}
                                  {% capture input_id %}ip-{{ section.id }}-{{ option.position }}-{{ forloop.index }}{% endcapture %}

                                  {% liquid
                                    assign color_variant = value.variant

                                    if color_variant == blank and is_color_option
                                      for candidate_variant in product.variants
                                        if candidate_variant.options[option_index] == value
                                          assign color_variant = candidate_variant
                                          break
                                        endif
                                      endfor
                                    endif

                                    assign color_media = color_variant.featured_media.preview_image
                                    if color_media == blank
                                      assign color_media = color_variant.featured_image
                                    endif
                                  %}

                                  <div>
                                    <input
                                      id="{{ input_id }}"
                                      class="ip-option-input"
                                      type="radio"
                                      name="options[{{ option.name | escape }}]"
                                      value="{{ value | escape }}"
                                      data-option-input
                                      data-option-position="{{ option.position }}"
                                      aria-label="{% if is_color_option %}Color: {% endif %}{{ value | escape }}"
                                      data-option-available="{{ value.available }}"
                                      {% if option.selected_value == value %}
                                        checked
                                      {% endif %}
                                    >

                                    <label
                                      class="ip-option-button{% if is_color_option %} ip-option-button--color{% unless value.available %} is-unavailable{% endunless %}{% endif %}"
                                      for="{{ input_id }}"
                                      title="{{ value | escape }}"
                                      {% if is_color_option %}
                                        style="{% if roma_preview and color_variant != blank %}--ip-color-image: url('{{ 'roma-variant-' | append: color_variant.option2 | append: '-02-tres-quartos-direita.webp' | asset_url }}');{% elsif color_media != blank %}--ip-color-image: url('{{ color_media | image_url: width: 180 }}');{% elsif value.swatch.color %}--ip-color-fill: rgb({{ value.swatch.color.rgb }});{% endif %}"
                                      {% endif %}
                                    >
                                      {% if is_color_option %}
                                        <span class="ip-color-swatch-visual" aria-hidden="true"></span>
                                        <span class="ip-visually-hidden">{{ value }}</span>
                                      {% else %}
                                        {{ value }}
                                      {% endif %}
                                    </label>
                                  </div>
                                {% endif %}
                              {% endunless %}
                            {% endfor %}
                          </div>
                        </fieldset>
                      {% endfor %}
                    </div>
                  {% endif %}

                {% when 'quantity' %}
                  <div
                    class="
                      ip-block ip-size
                      ip-align-{{ block.settings.element_alignment }}
                    "
                    {{ block.shopify_attributes }}
                    style="
                      --size-adjustment: {{ block.settings.element_size }}%;
