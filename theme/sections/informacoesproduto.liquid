    min-width: 0;
  }

  #ip-{{ section.id }} .ip-order-bump-image-wrap {
    width: var(--ob-image-width-desktop, 190px);
    height: var(--ob-image-height-desktop, 250px);
    max-width: 100%;
    overflow: hidden;
    background: var(--ob-image-background, #f3f3f3);
    border-radius: var(--ob-image-radius, 0px);
  }

  #ip-{{ section.id }} .ip-order-bump-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: var(--ob-image-fit, contain);
    object-position: var(--ob-image-position, center center);
    transform: scale(var(--ob-image-scale-desktop, 1));
    transform-origin: center;
  }

  #ip-{{ section.id }} .ip-order-bump-content {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  #ip-{{ section.id }} .ip-order-bump-title {
    margin: 0;
    color: var(--ob-title-color, #111111);
    font-size: var(--ob-title-size-desktop, 25px);
    line-height: var(--ob-title-line-height, 1.25);
    font-weight: var(--ob-title-weight, 700);
    letter-spacing: var(--ob-title-letter-spacing, 0px);
    text-transform: var(--ob-title-transform, none);
    overflow-wrap: anywhere;
  }

  #ip-{{ section.id }} .ip-order-bump-price {
    margin-top: var(--ob-price-gap-desktop, 24px);
    color: var(--ob-price-color, #111111);
    font-size: var(--ob-price-size-desktop, 24px);
