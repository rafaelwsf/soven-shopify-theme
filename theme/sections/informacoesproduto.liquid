                {% when 'order_bump' %}
                  {% assign bump_product = block.settings.product %}
                  {% if bump_product != blank %}
                    {% assign bump_variant = bump_product.selected_or_first_available_variant %}
                    {% assign bump_image = block.settings.custom_image | default: bump_product.featured_image %}
                    {% assign bump_title = block.settings.custom_title | default: bump_product.title %}
                    {% assign ob_scale_d_base = block.settings.desktop_scale | divided_by: 100.0 %}
                    {% assign ob_scale_m_base = block.settings.mobile_scale | divided_by: 100.0 %}
                    {% assign ob_scale_d = ob_scale_d_base | times: elements_scale_desktop %}
                    {% assign ob_scale_m = ob_scale_m_base | times: elements_scale_mobile %}

                    <div
                      class="ip-block ip-order-bump"
                      data-order-bump
                      data-after-add="{{ block.settings.after_add }}"
                      {{ block.shopify_attributes }}
                      style="
                        --ob-width-desktop: {{ block.settings.desktop_width }}%;
                        --ob-width-mobile: {{ block.settings.mobile_width }}%;
                        --ob-margin-top-desktop: {{ block.settings.desktop_margin_top }}px;
                        --ob-margin-bottom-desktop: {{ block.settings.desktop_margin_bottom }}px;
                        --ob-margin-left-desktop: {{ block.settings.desktop_margin_left }}px;
                        --ob-margin-right-desktop: {{ block.settings.desktop_margin_right }}px;
                        --ob-margin-top-mobile: {{ block.settings.mobile_margin_top }}px;
                        --ob-margin-bottom-mobile: {{ block.settings.mobile_margin_bottom }}px;
                        --ob-margin-left-mobile: {{ block.settings.mobile_margin_left }}px;
                        --ob-margin-right-mobile: {{ block.settings.mobile_margin_right }}px;
                        --ob-padding-desktop: {{ block.settings.desktop_padding | times: ob_scale_d }}px;
                        --ob-padding-mobile: {{ block.settings.mobile_padding | times: ob_scale_m }}px;
                        --ob-background: {{ block.settings.background }};
                        --ob-border-width: {{ block.settings.border_width }}px;
                        --ob-border-color: {{ block.settings.border_color }};
                        --ob-radius: {{ block.settings.border_radius }}px;
                        --ob-heading-gap-desktop: {{ block.settings.heading_gap_desktop | times: ob_scale_d }}px;
                        --ob-heading-gap-mobile: {{ block.settings.heading_gap_mobile | times: ob_scale_m }}px;
                        --ob-heading-color: {{ block.settings.heading_color }};
                        --ob-heading-size-desktop: {{ block.settings.heading_size_desktop | times: ob_scale_d }}px;
                        --ob-heading-size-mobile: {{ block.settings.heading_size_mobile | times: ob_scale_m }}px;
