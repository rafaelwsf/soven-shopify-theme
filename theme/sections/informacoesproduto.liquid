                        --ob-title-color: {{ block.settings.title_color }};
                        --ob-title-size-desktop: {{ block.settings.title_size_desktop | times: ob_scale_d }}px;
                        --ob-title-size-mobile: {{ block.settings.title_size_mobile | times: ob_scale_m }}px;
