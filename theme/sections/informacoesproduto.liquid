    font-weight: var(--ob-price-weight, 400);
    letter-spacing: var(--ob-price-letter-spacing, 0px);
  }

  #ip-{{ section.id }} .ip-order-bump-variant {
    width: 100%;
    margin-top: var(--ob-variant-gap-desktop, 18px);
