    {
      "type": "range",
      "id": "text_left_mobile",
      "label": "Distância esquerda mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_bottom_mobile",
      "label": "Distância inferior mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 18
