{% style %}
  #categoria1-{{ section.id }} {
    width: 100%;
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #categoria1-{{ section.id }} .categoria1-heading {
    padding: 0 {{ section.settings.heading_padding }}px {{ section.settings.heading_bottom }}px;
    max-width: {{ section.settings.heading_width }}px;
    font-family: inherit;
    font-size: {{ section.settings.heading_size }}px;
    line-height: {{ section.settings.heading_line }};
    font-weight: 700;
    letter-spacing: {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
  }

  #categoria1-{{ section.id }} .categoria1-heading p {
    margin: 0;
  }

  #categoria1-{{ section.id }} .categoria1-heading .gray {
    color: {{ section.settings.heading_gray_color }};
  }

  #categoria1-{{ section.id }} .categoria1-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
    gap: 0;
    box-sizing: border-box;

    {% if section.settings.show_border %}
      border-top: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
      border-left: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    {% else %}
      border: 0;
    {% endif %}
  }

  #categoria1-{{ section.id }} .categoria1-card {
    min-width: 0;
    min-height: {{ section.settings.card_height }}px;
    background: {{ section.settings.card_bg }};
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
    margin: 0;
    padding: 0;

    {% if section.settings.show_border %}
      border-right: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
      border-bottom: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    {% else %}
      border: 0;
    {% endif %}
  }

  #categoria1-{{ section.id }} .categoria1-image {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    max-width: none;
    display: block;
    margin: 0;
  }

  #categoria1-{{ section.id }} .categoria1-image--1 {
    width: {{ section.settings.image_width_1 }}%;
    height: {{ section.settings.image_height_1 }}%;
    object-fit: {{ section.settings.image_fit_1 }};
    object-position: {{ section.settings.image_position_1 }};
    transform: translate(-50%, -50%);
  }

  #categoria1-{{ section.id }} .categoria1-image--2 {
    width: {{ section.settings.image_width_2 }}%;
    height: {{ section.settings.image_height_2 }}%;
    object-fit: {{ section.settings.image_fit_2 }};
    object-position: {{ section.settings.image_position_2 }};
    transform: translate(-50%, -50%);
  }

  #categoria1-{{ section.id }} .categoria1-overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
    pointer-events: none;
  }

  #categoria1-{{ section.id }} .categoria1-link {
    position: absolute;
    z-index: 2;
    text-decoration: none;
    box-sizing: border-box;
    padding: {{ section.settings.content_padding }}px;
  }

  #categoria1-{{ section.id }} .categoria1-link--1 {
    left: {{ section.settings.text_x_1 }}%;
    top: {{ section.settings.text_y_1 }}%;
    transform: translate(
      -{{ section.settings.text_x_1 }}%,
      -{{ section.settings.text_y_1 }}%
    );
  }

  #categoria1-{{ section.id }} .categoria1-link--2 {
    left: {{ section.settings.text_x_2 }}%;
    top: {{ section.settings.text_y_2 }}%;
    transform: translate(
      -{{ section.settings.text_x_2 }}%,
      -{{ section.settings.text_y_2 }}%
    );
  }

  #categoria1-{{ section.id }} .categoria1-title {
    margin: 0;
    font-family: inherit;
    font-size: {{ section.settings.font_size }}px;
    line-height: {{ section.settings.line_height }};
    letter-spacing: {{ section.settings.letter_spacing }}px;
    text-transform: {{ section.settings.text_transform }};
    font-weight: 500;
    white-space: nowrap;
  }

  #categoria1-{{ section.id }} .categoria1-title--1 {
    color: {{ section.settings.text_color_1 }};
  }

  #categoria1-{{ section.id }} .categoria1-title--2 {
    color: {{ section.settings.text_color_2 }};
  }

  @media screen and (max-width: 749px) {
    #categoria1-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }

    #categoria1-{{ section.id }} .categoria1-heading {
      padding: 0 {{ section.settings.heading_padding_mobile }}px {{ section.settings.heading_bottom_mobile }}px;
      max-width: 100%;
      font-size: {{ section.settings.heading_size_mobile }}px;
      letter-spacing: {{ section.settings.heading_spacing_mobile }}px;
    }

    #categoria1-{{ section.id }} .categoria1-grid {
      grid-template-columns: repeat(
        {{ section.settings.columns_mobile }},
        minmax(0, 1fr)
      );
      gap: 0;
    }

    #categoria1-{{ section.id }} .categoria1-card {
      min-height: {{ section.settings.card_height_mobile }}px;
    }

    #categoria1-{{ section.id }} .categoria1-link {
      padding: {{ section.settings.content_padding_mobile }}px;
    }

    #categoria1-{{ section.id }} .categoria1-title {
      font-size: {{ section.settings.font_size_mobile }}px;
      letter-spacing: {{ section.settings.letter_spacing_mobile }}px;
    }
  }
{% endstyle %}

<section id="categoria1-{{ section.id }}">
  {% if section.settings.heading_black != blank or section.settings.heading_gray != blank %}
    <div class="categoria1-heading">
      <p>
        {{ section.settings.heading_black }}
        <span class="gray">
          {{ section.settings.heading_gray }}
        </span>
      </p>
    </div>
  {% endif %}

  <div class="categoria1-grid">
    <div class="categoria1-card">
      {% if section.settings.image_1 != blank %}
        {{
          section.settings.image_1
          | image_url: width: 1600
          | image_tag:
            class: 'categoria1-image categoria1-image--1',
            loading: 'lazy',
            widths: '500, 800, 1000, 1200, 1600'
        }}
      {% endif %}

      <div class="categoria1-overlay"></div>

      <a
        class="categoria1-link categoria1-link--1"
        href="{% if section.settings.collection_1 != blank %}{{ section.settings.collection_1.url }}{% else %}#{% endif %}"
      >
        <h3 class="categoria1-title categoria1-title--1">
          {% if section.settings.title_1 != blank %}
            {{ section.settings.title_1 }}
          {% elsif section.settings.collection_1 != blank %}
            {{ section.settings.collection_1.title }}
          {% else %}
            CATEGORÍA 1
          {% endif %}
        </h3>
      </a>
    </div>

    <div class="categoria1-card">
      {% if section.settings.image_2 != blank %}
        {{
          section.settings.image_2
          | image_url: width: 1600
          | image_tag:
            class: 'categoria1-image categoria1-image--2',
            loading: 'lazy',
            widths: '500, 800, 1000, 1200, 1600'
        }}
      {% endif %}

      <div class="categoria1-overlay"></div>

      <a
        class="categoria1-link categoria1-link--2"
        href="{% if section.settings.collection_2 != blank %}{{ section.settings.collection_2.url }}{% else %}#{% endif %}"
      >
        <h3 class="categoria1-title categoria1-title--2">
          {% if section.settings.title_2 != blank %}
            {{ section.settings.title_2 }}
          {% elsif section.settings.collection_2 != blank %}
            {{ section.settings.collection_2.title }}
          {% else %}
            CATEGORÍA 2
          {% endif %}
        </h3>
      </a>
    </div>
  </div>
</section>

