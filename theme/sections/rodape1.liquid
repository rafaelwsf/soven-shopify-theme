{% style %}
  #rodape1-{{ section.id }} {
    width: 100%;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    font-family: inherit;
    overflow: hidden;
  }

  #rodape1-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  #rodape1-{{ section.id }} .rodape1-top {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 0.8fr 0.8fr;
    gap: {{ section.settings.column_gap }}px;
  }

  #rodape1-{{ section.id }} .rodape1-title {
    margin: 0 0 {{ section.settings.title_margin }}px;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }

  #rodape1-{{ section.id }} .rodape1-text {
    margin: 0 0 {{ section.settings.newsletter_gap }}px;
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.3;
  }

  #rodape1-{{ section.id }} .rodape1-form {
    display: flex;
    align-items: center;
    border-bottom: 1px solid {{ section.settings.text_color }};
    max-width: {{ section.settings.form_width }}px;
  }

  #rodape1-{{ section.id }} .rodape1-input {
    flex: 1;
    border: 0;
    background: transparent;
    padding: 12px 6px;
    font-size: {{ section.settings.text_size }}px;
    color: {{ section.settings.text_color }};
    outline: none;
    font-family: inherit;
  }

  #rodape1-{{ section.id }} .rodape1-input::placeholder {
    color: {{ section.settings.placeholder_color }};
  }

  #rodape1-{{ section.id }} .rodape1-button {
    border: 0;
    background: transparent;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    cursor: pointer;
    font-family: inherit;
    padding: 12px 6px;
    text-transform: uppercase;
  }

  #rodape1-{{ section.id }} .rodape1-list {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.link_gap }}px;
  }

  #rodape1-{{ section.id }} .rodape1-link {
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.2;
  }

  #rodape1-{{ section.id }} .rodape1-social {
    display: flex;
    justify-content: flex-end;
    gap: {{ section.settings.social_gap }}px;
    margin-top: {{ section.settings.social_margin }}px;
  }

  #rodape1-{{ section.id }} .rodape1-social a {
    width: {{ section.settings.social_size }}px;
    height: {{ section.settings.social_size }}px;
    border-radius: 50%;
    background: {{ section.settings.social_bg_color }};
    color: {{ section.settings.social_icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #rodape1-{{ section.id }} .rodape1-social svg {
    width: {{ section.settings.social_icon_size }}px;
    height: {{ section.settings.social_icon_size }}px;
    display: block;
    fill: currentColor;
  }

  #rodape1-{{ section.id }} .rodape1-logo-wrap {
    width: 100%;
    overflow: visible;
    margin-top: {{ section.settings.logo_margin_top }}px;
    position: relative;
  }

  #rodape1-{{ section.id }} .rodape1-logo {
    display: block;
    width: max-content;
    max-width: none;
    white-space: nowrap;
    font-size: {{ section.settings.logo_size }}px;
    line-height: 0.82;
    letter-spacing: {{ section.settings.logo_spacing }}px;
    font-weight: 900;
    color: {{ section.settings.logo_color }};
    transform-origin: left center;
  }

  #rodape1-{{ section.id }} .rodape1-copyright-symbol {
    display: inline-block;
    font-size: {{ section.settings.copyright_size }}%;
    vertical-align: super;
    line-height: 0;
    margin-left: {{ section.settings.copyright_margin_left }}px;
    margin-right: {{ section.settings.copyright_margin_right }}px;
    position: relative;
    top: {{ section.settings.copyright_position_y }}px;
  }

  @media screen and (max-width: 749px) {
    #rodape1-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_horizontal_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
    }

    #rodape1-{{ section.id }} .rodape1-top {
      grid-template-columns: 1fr;
      gap: {{ section.settings.column_gap_mobile }}px;
    }

    #rodape1-{{ section.id }} .rodape1-title {
      font-size: {{ section.settings.title_size_mobile }}px;
    }

    #rodape1-{{ section.id }} .rodape1-text,
    #rodape1-{{ section.id }} .rodape1-input,
    #rodape1-{{ section.id }} .rodape1-button,
    #rodape1-{{ section.id }} .rodape1-link {
      font-size: {{ section.settings.text_size_mobile }}px;
    }

    #rodape1-{{ section.id }} .rodape1-form {
      max-width: 100%;
    }

    #rodape1-{{ section.id }} .rodape1-social {
      justify-content: flex-start;
      margin-top: {{ section.settings.social_margin_mobile }}px;
    }

    #rodape1-{{ section.id }} .rodape1-logo-wrap {
      margin-top: {{ section.settings.logo_margin_top_mobile }}px;
      padding-top: 18px;
      margin-bottom: -18px;
    }

    #rodape1-{{ section.id }} .rodape1-logo {
      font-size: {{ section.settings.logo_size_mobile }}px;
      letter-spacing: {{ section.settings.logo_spacing_mobile }}px;
    }
  }
{% endstyle %}

<footer id="rodape1-{{ section.id }}">
  <div class="rodape1-top">
    <div>
      <h3 class="rodape1-title">{{ section.settings.newsletter_title }}</h3>
      <p class="rodape1-text">{{ section.settings.newsletter_text }}</p>

      {% form 'customer', class: 'rodape1-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          class="rodape1-input"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.email_placeholder }}"
          required
        >
        <button class="rodape1-button" type="submit">
          {{ section.settings.button_text }}
        </button>
      {% endform %}
    </div>

    <div>
      <h3 class="rodape1-title">{{ section.settings.col_1_title }}</h3>
      <div class="rodape1-list">
        {% for link in linklists[section.settings.menu_1].links %}
          <a class="rodape1-link" href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </div>
    </div>

    <div>
      <h3 class="rodape1-title">{{ section.settings.col_2_title }}</h3>
      <div class="rodape1-list">
        {% for link in linklists[section.settings.menu_2].links %}
          <a class="rodape1-link" href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </div>
    </div>

    <div>
      <h3 class="rodape1-title">{{ section.settings.col_3_title }}</h3>
      <div class="rodape1-list">
        {% for link in linklists[section.settings.menu_3].links %}
          <a class="rodape1-link" href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </div>
    </div>
  </div>

  {% if section.settings.show_social %}
    <div class="rodape1-social">
      {% if section.settings.instagram_link != blank %}
        <a href="{{ section.settings.instagram_link }}" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm0 2A3.75 3.75 0 0 0 4 7.75v8.5A3.75 3.75 0 0 0 7.75 20h8.5A3.75 3.75 0 0 0 20 16.25v-8.5A3.75 3.75 0 0 0 16.25 4h-8.5Zm8.75 2.2a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/>
          </svg>
        </a>
      {% endif %}
    </div>
  {% endif %}

  <div class="rodape1-logo-wrap">
    <div class="rodape1-logo" data-rodape-logo>
      {% assign logo_parts = section.settings.big_logo_text | split: '©' %}
      {% if logo_parts.size > 1 %}
        {{ logo_parts[0] }}<span class="rodape1-copyright-symbol">©</span>{{ logo_parts[1] }}
      {% else %}
        {{ section.settings.big_logo_text }}
      {% endif %}
    </div>
  </div>
</footer>

<script>
  function resizeRodapeLogo{{ section.id | replace: '-', '' }}() {
    var section = document.querySelector('#rodape1-{{ section.id }}');
    if (!section) return;

    var wrap = section.querySelector('.rodape1-logo-wrap');
    var logo = section.querySelector('[data-rodape-logo]');
    if (!wrap || !logo) return;

    logo.style.transform = 'scale(1)';
    logo.style.marginBottom = '0px';

    var wrapWidth = wrap.clientWidth;
    var logoWidth = logo.scrollWidth;

    if (logoWidth > wrapWidth && logoWidth > 0) {
      var scale = wrapWidth / logoWidth;
      logo.style.transform = 'scale(' + scale + ')';
      logo.style.marginBottom = '-' + ((logo.offsetHeight * (1 - scale)) || 0) + 'px';
    }
  }

  document.addEventListener('DOMContentLoaded', resizeRodapeLogo{{ section.id | replace: '-', '' }});
  window.addEventListener('resize', resizeRodapeLogo{{ section.id | replace: '-', '' }});

  document.addEventListener('shopify:section:load', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      resizeRodapeLogo{{ section.id | replace: '-', '' }}();
    }
  });
</script>

