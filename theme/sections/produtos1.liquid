{% style %}
@font-face{font-family:'Produtos1Zierde';src:url('https://cdn.shopify.com/s/files/1/0780/8211/3725/files/zierde-grotesk-medium.otf?v=1782228267') format('opentype');font-weight:500;font-style:normal;font-display:swap}

#produtos1-{{ section.id }}{width:100%;max-width:100%;min-width:0;box-sizing:border-box;overflow-x:clip;background:{{ section.settings.bg_color }};padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}
#produtos1-{{ section.id }} .produtos1-grid{display:grid;grid-template-columns:repeat({{ section.settings.columns_desktop }},minmax(0,1fr));gap:0;width:100%;max-width:100%;min-width:0;border-top:{{ section.settings.border_width }}px solid {{ section.settings.border_color }};border-left:{{ section.settings.border_width }}px solid {{ section.settings.border_color }};box-sizing:border-box;overflow:hidden}
#produtos1-{{ section.id }} .produtos1-card{width:100%;max-width:100%;min-width:0;border-right:{{ section.settings.border_width }}px solid {{ section.settings.border_color }};border-bottom:{{ section.settings.border_width }}px solid {{ section.settings.border_color }};background:{{ section.settings.card_bg }};overflow:hidden;box-sizing:border-box}
#produtos1-{{ section.id }} .produtos1-link{text-decoration:none;color:inherit;display:block;width:100%;max-width:100%;min-width:0;height:100%;box-sizing:border-box;overflow:hidden}

#produtos1-{{ section.id }} .produtos1-image-wrap{
  width:100%;
  max-width:100%;
  min-width:0;
  height:{{ section.settings.image_box_height }}px;
  box-sizing:border-box;
  overflow:hidden;
  background:{{ section.settings.image_bg_color }};
  display:flex;
  align-items:center;
  justify-content:center;
}

#produtos1-{{ section.id }} .produtos1-image{
  width:100%;
  max-width:100%;
  min-width:0;
  height:100%;
  display:block;
  object-fit:{{ section.settings.image_fit }};
  object-position:{{ section.settings.image_position }};
  transform:scale({{ section.settings.image_scale | divided_by:100.0 }});
  transition:transform .4s ease;
}

{% if section.settings.enable_hover_zoom %}
#produtos1-{{ section.id }} .produtos1-card:hover .produtos1-image{transform:scale({{ section.settings.image_hover_scale | divided_by:100.0 }})}
{% endif %}

#produtos1-{{ section.id }} .produtos1-info{width:100%;max-width:100%;min-width:0;box-sizing:border-box;overflow:hidden;padding:{{ section.settings.info_padding }}px;font-family:'Produtos1Zierde',Arial,sans-serif;text-align:{{ section.settings.text_align }}}
#produtos1-{{ section.id }} .produtos1-title{max-width:100%;margin:0;overflow-wrap:anywhere;word-break:break-word;color:{{ section.settings.title_color }};font-size:{{ section.settings.title_size }}px;line-height:{{ section.settings.title_line_height }};letter-spacing:{{ section.settings.title_letter_spacing }}px;text-transform:{{ section.settings.title_transform }};font-weight:500}
#produtos1-{{ section.id }} .produtos1-price{max-width:100%;overflow-wrap:anywhere;word-break:break-word;margin-top:{{ section.settings.price_margin_top }}px;color:{{ section.settings.price_color }};font-size:{{ section.settings.price_size }}px;line-height:1.2;letter-spacing:{{ section.settings.price_letter_spacing }}px;font-weight:500}

@media(max-width:749px){
  #produtos1-{{ section.id }}{
    width:100%;
    max-width:100%;
    min-width:0;
    overflow-x:hidden;
    box-sizing:border-box;
    contain:inline-size;
    padding-top:{{ section.settings.padding_top_mobile }}px;
    padding-bottom:{{ section.settings.padding_bottom_mobile }}px;
  }

  #produtos1-{{ section.id }},
  #produtos1-{{ section.id }} .produtos1-grid,
  #produtos1-{{ section.id }} .produtos1-card,
  #produtos1-{{ section.id }} .produtos1-link,
  #produtos1-{{ section.id }} .produtos1-image-wrap,
  #produtos1-{{ section.id }} .produtos1-info{
    max-width:100%;
    min-width:0;
    box-sizing:border-box;
  }

  #produtos1-{{ section.id }} .produtos1-grid{
    width:100%;
    grid-template-columns:repeat({{ section.settings.columns_mobile }},minmax(0,1fr));
    overflow:hidden;
  }

  #produtos1-{{ section.id }} .produtos1-card,
  #produtos1-{{ section.id }} .produtos1-link{
    width:100%;
    overflow:hidden;
  }

  #produtos1-{{ section.id }} .produtos1-image{
    max-width:100%;
  }

  #produtos1-{{ section.id }} .produtos1-image-wrap{height:{{ section.settings.image_box_height_mobile }}px}
  #produtos1-{{ section.id }} .produtos1-info{width:100%;max-width:100%;min-width:0;box-sizing:border-box;overflow:hidden;padding:{{ section.settings.info_padding_mobile }}px}
  #produtos1-{{ section.id }} .produtos1-title{font-size:{{ section.settings.title_size_mobile }}px;letter-spacing:{{ section.settings.title_letter_spacing_mobile }}px}
  #produtos1-{{ section.id }} .produtos1-price{font-size:{{ section.settings.price_size_mobile }}px;letter-spacing:{{ section.settings.price_letter_spacing_mobile }}px}
}
{% endstyle %}

<section id="produtos1-{{ section.id }}">
  <div class="produtos1-grid">
    {% for item in (1..section.settings.products_limit) %}
      {% assign index = forloop.index %}
      {% assign collection_index = forloop.index0 %}

      {% assign product_key = 'manual_product_' | append: index %}
      {% assign image_key = 'custom_image_' | append: index %}
      {% assign title_key = 'custom_title_' | append: index %}
      {% assign price_key = 'custom_price_' | append: index %}

      {% assign manual_product = section.settings[product_key] %}
      {% assign custom_image = section.settings[image_key] %}
      {% assign custom_title = section.settings[title_key] %}
      {% assign custom_price = section.settings[price_key] %}

      {% assign product = manual_product %}

      {% if product == blank and section.settings.collection != blank %}
        {% assign product = section.settings.collection.products[collection_index] %}
      {% endif %}

      <div class="produtos1-card">
        {% if product != blank %}
          <a class="produtos1-link" href="{{ product.url }}">
        {% else %}
          <a class="produtos1-link" href="#">
        {% endif %}

          <div class="produtos1-image-wrap">
            {% if custom_image != blank %}
              {{ custom_image | image_url: width: 1400 | image_tag: class: 'produtos1-image', loading: 'lazy', widths: '300, 500, 700, 900, 1200, 1400' }}
            {% elsif product != blank and product.featured_image != blank %}
              {{ product.featured_image | image_url: width: 1400 | image_tag: class: 'produtos1-image', loading: 'lazy', widths: '300, 500, 700, 900, 1200, 1400' }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'produtos1-image' }}
            {% endif %}
          </div>

          {% if section.settings.show_info %}
            <div class="produtos1-info">
              {% if section.settings.show_title %}
                <h3 class="produtos1-title">
                  {% if custom_title != blank %}
                    {{ custom_title }}
                  {% elsif product != blank %}
                    {{ product.title }}
                  {% else %}
                    Produto
                  {% endif %}
                </h3>
              {% endif %}

              {% if section.settings.show_price %}
                <div class="produtos1-price">
                  {% if custom_price != blank %}
                    {{ custom_price }}
                  {% elsif product != blank %}
                    {{ product.price | money }}
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        </a>
      </div>
    {% endfor %}
  </div>
</section>

