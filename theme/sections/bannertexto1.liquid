{% style %}
  #bannertexto1-{{ section.id }} {
    width: 100%;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-family: inherit;
  }

  #bannertexto1-{{ section.id }} .bt1-top {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    gap: {{ section.settings.column_gap }}px;
    padding: 0 {{ section.settings.side_padding }}px;
    align-items: start;
  }

  #bannertexto1-{{ section.id }} .bt1-brand {
    margin: 0;
    font-size: {{ section.settings.brand_size }}px;
    line-height: 0.95;
    font-weight: 700;
    letter-spacing: {{ section.settings.brand_spacing }}px;
  }

  #bannertexto1-{{ section.id }} .bt1-menu {
    display: flex;
    justify-content: center;
    gap: {{ section.settings.menu_gap }}px;
    font-size: {{ section.settings.menu_size }}px;
    line-height: 1.1;
  }

  #bannertexto1-{{ section.id }} .bt1-menu a,
  #bannertexto1-{{ section.id }} .bt1-project a {
    color: inherit;
    text-decoration: none;
  }

  #bannertexto1-{{ section.id }} .bt1-project {
    text-align: right;
    font-size: {{ section.settings.menu_size }}px;
    line-height: 1.1;
    text-decoration: underline;
  }

  #bannertexto1-{{ section.id }} .bt1-description {
    width: 100%;
    max-width: none;
    display: grid;
    grid-template-columns: 42% 58%;
    padding: 0 {{ section.settings.side_padding }}px;
    margin-top: {{ section.settings.description_top }}px;
    margin-bottom: {{ section.settings.description_bottom }}px;
    box-sizing: border-box;
  }

  #bannertexto1-{{ section.id }} .bt1-description p {
    grid-column: 2;
    margin: 0;
    width: 100%;
    max-width: none;
    font-size: {{ section.settings.description_size }}px;
    line-height: {{ section.settings.description_line_height }};
    letter-spacing: {{ section.settings.description_spacing }}px;
    font-weight: 500;
  }

  #bannertexto1-{{ section.id }} .bt1-meta {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 24px;
    gap: 20px;
    padding: 0 {{ section.settings.side_padding }}px {{ section.settings.meta_bottom }}px;
    font-size: {{ section.settings.meta_size }}px;
    line-height: 1.1;
  }

  #bannertexto1-{{ section.id }} .bt1-meta-center {
    text-align: center;
  }

  #bannertexto1-{{ section.id }} .bt1-meta-right {
    text-align: right;
    color: {{ section.settings.muted_color }};
  }

  #bannertexto1-{{ section.id }} .bt1-arrow {
    text-align: right;
  }

  #bannertexto1-{{ section.id }} .bt1-image-wrap {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    overflow: hidden;
  }

  #bannertexto1-{{ section.id }} .bt1-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
  }

  #bannertexto1-{{ section.id }} .bt1-placeholder {
    width: 100%;
    height: 100%;
    background: #eeeeee;
  }

  @media screen and (max-width: 749px) {
    #bannertexto1-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #bannertexto1-{{ section.id }} .bt1-top {
      grid-template-columns: 1fr;
      gap: {{ section.settings.column_gap_mobile }}px;
      padding: 0 {{ section.settings.side_padding_mobile }}px;
    }

    #bannertexto1-{{ section.id }} .bt1-brand {
      font-size: {{ section.settings.brand_size_mobile }}px;
      letter-spacing: {{ section.settings.brand_spacing_mobile }}px;
    }

    #bannertexto1-{{ section.id }} .bt1-menu {
      justify-content: flex-start;
      font-size: {{ section.settings.menu_size_mobile }}px;
    }

    #bannertexto1-{{ section.id }} .bt1-project {
      text-align: left;
      font-size: {{ section.settings.menu_size_mobile }}px;
    }

    #bannertexto1-{{ section.id }} .bt1-description {
      display: block;
      padding: 0 {{ section.settings.side_padding_mobile }}px;
      margin-top: {{ section.settings.description_top_mobile }}px;
      margin-bottom: {{ section.settings.description_bottom_mobile }}px;
    }

    #bannertexto1-{{ section.id }} .bt1-description p {
      width: 100%;
      font-size: {{ section.settings.description_size_mobile }}px;
    }

    #bannertexto1-{{ section.id }} .bt1-meta {
      grid-template-columns: 1fr;
      gap: {{ section.settings.meta_gap_mobile }}px;
      padding: 0 {{ section.settings.side_padding_mobile }}px {{ section.settings.meta_bottom_mobile }}px;
      font-size: {{ section.settings.meta_size_mobile }}px;
    }

    #bannertexto1-{{ section.id }} .bt1-meta-center,
    #bannertexto1-{{ section.id }} .bt1-meta-right,
    #bannertexto1-{{ section.id }} .bt1-arrow {
      text-align: left;
    }

    #bannertexto1-{{ section.id }} .bt1-image-wrap {
      height: {{ section.settings.image_height_mobile }}px;
    }
  }
{% endstyle %}

<section id="bannertexto1-{{ section.id }}">
  <div class="bt1-top">
    <h2 class="bt1-brand">{{ section.settings.brand_text }}</h2>

    <nav class="bt1-menu">
      {% if section.settings.menu_text_1 != blank %}
        <a href="{{ section.settings.menu_link_1 }}">{{ section.settings.menu_text_1 }}</a>
      {% endif %}
      {% if section.settings.menu_text_2 != blank %}
        <a href="{{ section.settings.menu_link_2 }}">{{ section.settings.menu_text_2 }}</a>
      {% endif %}
      {% if section.settings.menu_text_3 != blank %}
        <a href="{{ section.settings.menu_link_3 }}">{{ section.settings.menu_text_3 }}</a>
      {% endif %}
    </nav>

    <div class="bt1-project">
      <a href="{{ section.settings.project_link }}">{{ section.settings.project_text }}</a>
    </div>
  </div>

  <div class="bt1-description">
    {{ section.settings.description }}
  </div>

  <div class="bt1-meta">
    <div>{{ section.settings.meta_left }}</div>
    <div class="bt1-meta-center">{{ section.settings.meta_center }}</div>
    <div class="bt1-meta-right">{{ section.settings.meta_right }}</div>
    <div class="bt1-arrow">{{ section.settings.arrow_text }}</div>
  </div>

  <div class="bt1-image-wrap">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'bt1-image',
          loading: 'lazy',
          widths: '600, 900, 1200, 1600, 2000, 2400'
      }}
    {% else %}
      <div class="bt1-placeholder"></div>
    {% endif %}
  </div>
</section>

