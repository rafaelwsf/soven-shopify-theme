{% style %}
  #faq1-{{ section.id }} {
    width: 100%;
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #faq1-{{ section.id }} .faq1-title {
    margin: 0;
    padding: 0 {{ section.settings.side_padding }}px {{ section.settings.title_bottom }}px;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size }}px;
    line-height: 0.9;
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
    text-transform: uppercase;
    font-weight: 700;
  }

  #faq1-{{ section.id }} .faq1-list {
    width: 100%;
    border-top: {{ section.settings.line_width }}px solid {{ section.settings.line_color }};
  }

  #faq1-{{ section.id }} .faq1-item {
    border-bottom: {{ section.settings.line_width }}px solid {{ section.settings.line_color }};
  }

  #faq1-{{ section.id }} .faq1-question {
    width: 100%;
    padding: {{ section.settings.item_padding_y }}px {{ section.settings.side_padding }}px;
    background: transparent;
    border: 0;
    cursor: pointer;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    color: {{ section.settings.question_color }};
    font-size: {{ section.settings.question_size }}px;
    line-height: 1.1;
    letter-spacing: {{ section.settings.question_letter_spacing }}px;
    text-transform: uppercase;
    font-weight: 500;
  }

  #faq1-{{ section.id }} .faq1-icon {
    flex: 0 0 auto;
    font-size: {{ section.settings.icon_size }}px;
    line-height: 1;
    transition: transform 0.25s ease;
  }

  #faq1-{{ section.id }} .faq1-answer {
    display: none;
    padding: 0 {{ section.settings.side_padding }}px {{ section.settings.answer_padding_bottom }}px;
    color: {{ section.settings.answer_color }};
    font-size: {{ section.settings.answer_size }}px;
    line-height: {{ section.settings.answer_line_height }};
    letter-spacing: {{ section.settings.answer_letter_spacing }}px;
    max-width: {{ section.settings.answer_max_width }}px;
  }

  #faq1-{{ section.id }} .faq1-item.active .faq1-answer {
    display: block;
  }

  #faq1-{{ section.id }} .faq1-item.active .faq1-icon {
    transform: rotate(45deg);
  }

  @media screen and (max-width: 749px) {
    #faq1-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #faq1-{{ section.id }} .faq1-title {
      padding-left: {{ section.settings.side_padding_mobile }}px;
      padding-right: {{ section.settings.side_padding_mobile }}px;
      padding-bottom: {{ section.settings.title_bottom_mobile }}px;
      font-size: {{ section.settings.title_size_mobile }}px;
      letter-spacing: {{ section.settings.title_letter_spacing_mobile }}px;
    }

    #faq1-{{ section.id }} .faq1-question {
      padding: {{ section.settings.item_padding_y_mobile }}px {{ section.settings.side_padding_mobile }}px;
      font-size: {{ section.settings.question_size_mobile }}px;
      letter-spacing: {{ section.settings.question_letter_spacing_mobile }}px;
    }

    #faq1-{{ section.id }} .faq1-answer {
      padding-left: {{ section.settings.side_padding_mobile }}px;
      padding-right: {{ section.settings.side_padding_mobile }}px;
      padding-bottom: {{ section.settings.answer_padding_bottom_mobile }}px;
      font-size: {{ section.settings.answer_size_mobile }}px;
      letter-spacing: {{ section.settings.answer_letter_spacing_mobile }}px;
    }
  }
{% endstyle %}

<section id="faq1-{{ section.id }}">
  <h2 class="faq1-title">{{ section.settings.title }}</h2>

  <div class="faq1-list">
    {% for block in section.blocks %}
      <div class="faq1-item" {{ block.shopify_attributes }}>
        <button class="faq1-question" type="button" aria-expanded="false">
          <span>{{ block.settings.question }}</span>
          <span class="faq1-icon">+</span>
        </button>

        <div class="faq1-answer">
          {{ block.settings.answer }}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('#faq1-{{ section.id }}');
    if (!section) return;

    var items = section.querySelectorAll('.faq1-item');

    items.forEach(function (item) {
      var button = item.querySelector('.faq1-question');

      button.addEventListener('click', function () {
        var isActive = item.classList.contains('active');

        {% if section.settings.close_others %}
          items.forEach(function (otherItem) {
            otherItem.classList.remove('active');
            var otherButton = otherItem.querySelector('.faq1-question');
            if (otherButton) otherButton.setAttribute('aria-expanded', 'false');
          });
        {% endif %}

        if (!isActive) {
          item.classList.add('active');
          button.setAttribute('aria-expanded', 'true');
        } else {
          item.classList.remove('active');
          button.setAttribute('aria-expanded', 'false');
        }
      });
    });
  });
</script>

