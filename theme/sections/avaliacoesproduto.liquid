<script>
  (() => {
    const section = document.getElementById('avaliacoesproduto-{{ section.id }}');

    if (!section || section.dataset.initialized === 'true') return;

    section.dataset.initialized = 'true';

    const reviewsList = section.querySelector('[data-reviews-list]');

    const reviews = reviewsList
      ? Array.from(reviewsList.querySelectorAll('[data-review]'))
      : [];

    const filterButtons = Array.from(
      section.querySelectorAll('[data-rating-filter]')
    );

    const sortSelect = section.querySelector('[data-sort-select]');
    const resultsCount = section.querySelector('[data-results-count]');
    const emptyFilter = section.querySelector('[data-empty-filter]');
    const scrollButton = section.querySelector('[data-scroll-reviews]');
    const reviewsArea = section.querySelector('[data-reviews-area]');

    let activeFilter = reviews.length > 0 ? '5' : 'all';

    const singularText = {{ section.settings.review_singular | json }};
    const pluralText = {{ section.settings.review_plural | json }};
    const resultsConnector = {{ section.settings.results_connector | json }};
    const noReviewsText = {{ section.settings.no_reviews_text | json }};

    function setActiveButton(selectedButton) {
      filterButtons.forEach((button) => {
        const isSelected = button === selectedButton;

        button.classList.toggle('is-active', isSelected);
        button.setAttribute(
          'aria-pressed',
          isSelected ? 'true' : 'false'
        );
      });
    }

    function updateCount(visibleCount) {
      if (!resultsCount) return;

      if (reviews.length === 0) {
        resultsCount.textContent = noReviewsText;
        return;
      }

      if (visibleCount === 0) {
        resultsCount.textContent =
          `0 ${resultsConnector} 0 ${pluralText}`.toUpperCase();

        return;
      }

      const reviewWord =
        visibleCount === 1 ? singularText : pluralText;

      resultsCount.textContent =
        `1 – ${visibleCount} ${resultsConnector} ${visibleCount} ${reviewWord}`.toUpperCase();
    }

    function filterReviews() {
      let visibleCount = 0;

      reviews.forEach((review) => {
        const shouldShow =
          activeFilter === 'all' ||
          review.dataset.rating === activeFilter;

        review.hidden = !shouldShow;

        if (shouldShow) {
          visibleCount += 1;
        }
      });

      updateCount(visibleCount);

      if (emptyFilter) {
        emptyFilter.hidden = visibleCount !== 0;
      }
    }

    function sortReviews(sortType) {
      if (!reviewsList) return;

      const sortedReviews = [...reviews].sort((reviewA, reviewB) => {
        const ratingA = Number(reviewA.dataset.rating || 0);
        const ratingB = Number(reviewB.dataset.rating || 0);
        const dateA = Number(reviewA.dataset.date || 0);
        const dateB = Number(reviewB.dataset.date || 0);

        switch (sortType) {
          case 'oldest':
            return dateA - dateB;

          case 'highest':
            return ratingB - ratingA || dateB - dateA;

          case 'lowest':
            return ratingA - ratingB || dateB - dateA;

          case 'newest':
          default:
            return dateB - dateA;
        }
      });

      sortedReviews.forEach((review) => {
        reviewsList.appendChild(review);
      });
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.ratingFilter || 'all';

        setActiveButton(button);
        filterReviews();
      });
    });

    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        sortReviews(sortSelect.value);
      });
    }

    if (scrollButton && reviewsArea) {
      scrollButton.addEventListener('click', () => {
        reviewsArea.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      });
    }

    section
      .querySelectorAll('[data-translation-toggle]')
      .forEach((button) => {
        button.addEventListener('click', () => {
          const translatedText =
            button.parentElement.querySelector(
              '[data-translated-text]'
            );

          if (!translatedText) return;

          const isExpanded =
            button.getAttribute('aria-expanded') === 'true';

          button.setAttribute(
            'aria-expanded',
            isExpanded ? 'false' : 'true'
          );

          translatedText.hidden = isExpanded;
        });
      });

    sortReviews('newest');
    filterReviews();
  })();
</script>

