<soven-bundle class="soven-bundle" data-currency="{{ cart.currency.iso_code | default: shop.currency }}" {{ block.shopify_attributes }}>
  <h2>{{ block.settings.heading | escape }}</h2>
  <p class="soven-bundle__intro">{{ block.settings.subtitle | escape }}</p>
  <script type="application/json" data-bundle-variants>{{ product.variants | json }}</script>
  {% for count in (1..3) %}
    <div class="soven-bundle__option" data-bundle-option="{{ count }}">
      <label class="soven-bundle__label">
        <input type="radio" name="soven-pack-{{ block.id }}" value="{{ count }}" {% if count == 1 %}checked{% endif %}>
        <span><strong>{% case count %}{% when 1 %}Un esencial{% when 2 %}Dúo Soven{% when 3 %}Trío Soven{% endcase %}</strong><small>{{ count }} {% if count == 1 %}par de gafas{% else %}pares de gafas{% endif %}</small></span>
        <span class="soven-bundle__total" data-bundle-total></span>
      </label>
      <div class="soven-bundle__choices" {% unless count == 1 %}hidden{% endunless %}>
        {% for slot in (1..count) %}
          <label><span>Gafas {{ slot }}</span><select data-bundle-select aria-label="Variante de las gafas {{ slot }} del pack de {{ count }}" {% unless count == 1 %}disabled{% endunless %}>
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" {% if variant.id == product.selected_or_first_available_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} — Agotado{% endunless %}</option>
            {% endfor %}
          </select></label>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
  <p class="soven-bundle__note">Elige un color para cada par. Cantidad indica el número de packs.</p>
  <p data-bundle-status role="status" aria-live="polite"></p>
</soven-bundle>
{{ 'soven-bundle.css' | asset_url | stylesheet_tag }}
<script src="{{ 'soven-bundle.js' | asset_url }}" defer></script>
