{% liquid
  assign configured = 0
  for i in (1..3)
    assign key = 'product_' | append: i
    if block.settings[key] != blank
      assign configured = configured | plus: 1
    endif
  endfor
%}
{% if configured > 0 or request.design_mode %}
  <soven-complete-look class="soven-look" {{ block.shopify_attributes }}>
    <h2>{{ block.settings.heading | escape }}</h2>
    <div class="soven-look__grid">
      {% for i in (1..3) %}
        {% liquid
          assign key = 'product_' | append: i
          assign item = block.settings[key]
          assign image_key = 'image_' | append: i
          assign title_key = 'title_' | append: i
          assign text_key = 'text_' | append: i
          assign photo = block.settings[image_key] | default: item.featured_image
          assign title = block.settings[title_key] | default: item.title
          assign selected = item.selected_or_first_available_variant
        %}
        {% if item != blank %}
          <article class="soven-look__card">
            <a href="{{ item.url }}" class="soven-look__image" aria-label="{{ title | escape }}">
              {% if photo %}{{ photo | image_url: width: 600 | image_tag: loading: 'lazy', widths: '150,300,600', sizes: '(max-width: 749px) 42vw, 200px', alt: title }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
            </a>
            <h3><a href="{{ item.url }}">{{ title | escape }}</a></h3>
            <p class="soven-look__price" data-price>{{ selected.price | money }}</p>
            <s data-compare {% unless selected.compare_at_price > selected.price %}hidden{% endunless %}>{{ selected.compare_at_price | money }}</s>
            {% if block.settings[text_key] != blank %}<p>{{ block.settings[text_key] | escape }}</p>{% endif %}
            <label class="soven-look__variant">Variante
              <select aria-label="Variante de {{ title | escape }}" data-variant>
                {% for variant in item.variants %}
                  <option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}" {% unless variant.available %}disabled{% endunless %} {% if variant.id == selected.id %}selected{% endif %}>
                    {% if item.has_only_default_variant %}Única{% else %}{{ variant.title | escape }}{% endif %}{% unless variant.available %} — Agotado{% endunless %}
                  </option>
                {% endfor %}
              </select>
            </label>
            {% if item.requires_selling_plan %}
              <a href="{{ item.url }}">Elegir suscripción</a>
            {% else %}
              <button type="button" data-add-look {% unless item.available %}disabled{% endunless %}>{% if item.available %}{{ block.settings.button_label | escape }}{% else %}AGOTADO{% endif %}</button>
            {% endif %}
            <p data-status role="status" aria-live="polite"></p>
          </article>
        {% elsif request.design_mode %}
          <div class="soven-look__card"><div class="soven-look__image">{{ 'product-1' | placeholder_svg_tag }}</div><p>Selecciona el producto {{ i }} en este bloque.</p></div>
        {% endif %}
      {% endfor %}
    </div>
  </soven-complete-look>
  <script src="{{ 'complete-look.js' | asset_url }}" defer></script>
  {{ 'complete-look.css' | asset_url | stylesheet_tag }}
{% endif %}
